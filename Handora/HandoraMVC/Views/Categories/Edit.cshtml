@model HandoraMVC.ViewModels.EditCategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-card">
    <h2>Edit Category</h2>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-error"></div>

        <div class="form-group">
            <label asp-for="NameEn">Name (English)</label>
            <input asp-for="NameEn" class="form-input" />
            <span asp-validation-for="NameEn" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="NameAr">Name (Arabic)</label>
            <input asp-for="NameAr" class="form-input" />
            <span asp-validation-for="NameAr" class="field-error"></span>
        </div>

        <input type="hidden" asp-for="ImageUrl" />
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="form-group">
                <label>Current Image</label>
                <div style="margin-top: 6px; margin-bottom: 12px;">
                    <img src="@Model.ImageUrl" alt="Current Image" style="max-height: 120px; border-radius: 8px; border: 1px solid #e8e0d8; object-fit: cover;" />
                </div>
            </div>
        }
        <div class="form-group">
            <label asp-for="ImageFile">Change Image <span style="color:#aaa;font-weight:400">(optional)</span></label>
            <input asp-for="ImageFile" type="file" accept="image/*" class="form-input" />
            <span asp-validation-for="ImageFile" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ParentId">Parent Category (optional)</label>
            <select asp-for="ParentId" asp-items="Model.ParentCategories" class="form-input">
                <option value="">-- None --</option>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Save</button>
            <a asp-action="Index" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>