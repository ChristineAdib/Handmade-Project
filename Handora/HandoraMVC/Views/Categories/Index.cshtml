@model List<HandoraMVC.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h2>Categories</h2>
    <a asp-action="Create" class="btn-primary">+ Add Category</a>
</div>

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Image</th>
                <th>Name (EN)</th>
                <th>Name (AR)</th>
                <th>Subcategories</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                        {
                            <img src="@cat.ImageUrl" alt="@cat.NameEn" class="cat-img" />
                        }
                        else
                        {
                            <div class="cat-img-placeholder">📦</div>
                        }
                    </td>
                    <td>@cat.NameEn</td>
                    <td>@cat.NameAr</td>
                    <td>
                        <span class="badge">@cat.SubCategories.Count</span>
                    </td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@cat.Id" class="btn-edit">Edit</a>
                        <a asp-action="Delete" asp-route-id="@cat.Id" class="btn-delete">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>