@model HandoraMVC.ViewModels.CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-card">
    <h2>New Category</h2>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-error"></div>

        <div class="form-group">
            <label asp-for="NameEn">Name (English)</label>
            <input asp-for="NameEn" class="form-input" />
            <span asp-validation-for="NameEn" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="NameAr">Name (Arabic)</label>
            <input asp-for="NameAr" class="form-input" />
            <span asp-validation-for="NameAr" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ImageUrl">Image URL</label>
            <input asp-for="ImageUrl" class="form-input" />
        </div>

        <div class="form-group">
            <label asp-for="ParentId">Parent Category (optional)</label>
            <select asp-for="ParentId" asp-items="Model.ParentCategories" class="form-input">
                <option value="">-- None --</option>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create</button>
            <a asp-action="Index" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>