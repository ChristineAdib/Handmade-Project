@model HandoraMVC.ViewModels.UserManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    .users-container {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #2b1d15;
    }

    .premium-header {
        background: linear-gradient(135deg, #fbf9f6 0%, #f3ede4 100%);
        padding: 24px 30px;
        border-radius: 16px;
        border: 1px solid #e8dfd3;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(61, 32, 16, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .premium-header-title h2 {
        font-size: 22px;
        font-weight: 700;
        color: #3d2010;
        margin: 0 0 6px 0;
        letter-spacing: -0.5px;
    }

    .premium-header-title p {
        font-size: 13px;
        color: #7a6151;
        margin: 0;
    }

    .total-badge-premium {
        background: #3d2010;
        color: #f5e6d3;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(61, 32, 16, 0.15);
    }

    .premium-card {
        background: #ffffff;
        border: 1px solid #e8dfd3;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(61, 32, 16, 0.04);
        overflow: hidden;
    }

    .premium-toolbar {
        background: #fbf9f6;
        padding: 20px 24px;
        border-bottom: 1px solid #e8dfd3;
    }

    .filter-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: flex-end;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-item label {
        font-size: 12px;
        font-weight: 600;
        color: #7a6151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .premium-select {
        min-width: 180px;
        height: 42px;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 500;
        font-family: inherit;
        border: 1.5px solid #d4c8bc;
        border-radius: 10px;
        background-color: #ffffff;
        color: #3d2010;
        outline: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .premium-select:focus {
        border-color: #c4956a;
        box-shadow: 0 0 0 3px rgba(196, 149, 106, 0.15);
    }

    .btn-clear-premium {
        height: 42px;
        padding: 0 20px;
        background: #ffffff;
        color: #7a5433;
        border: 1.5px solid #c4956a;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-clear-premium:hover {
        background: #fdfaf6;
        border-color: #3d2010;
        color: #3d2010;
    }

    .premium-table {
        width: 100%;
        border-collapse: collapse;
    }

    .premium-table th {
        background-color: #fbf9f6;
        color: #7a6151;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 16px 24px;
        border-bottom: 1.5px solid #e8dfd3;
        text-align: left;
    }

    .premium-table td {
        padding: 18px 24px;
        border-bottom: 1px solid #f0ebe4;
        vertical-align: middle;
        font-size: 14px;
    }

    .premium-table tr:last-child td {
        border-bottom: none;
    }

    .premium-table tr:hover td {
        background-color: #fdfcfb;
    }

    /* Avatars */
    .avatar-circle-premium {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 15px;
        color: #3d2010;
        background: linear-gradient(135deg, #f5ede4 0%, #e8dfd3 100%);
        border: 2px solid #ffffff;
        box-shadow: 0 3px 8px rgba(61, 32, 16, 0.08);
    }

    .avatar-img-premium {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #ffffff;
        box-shadow: 0 3px 8px rgba(61, 32, 16, 0.08);
    }

    /* Badges */
    .role-badge-premium {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .role-admin { background: #fcebeb; color: #a32d2d; border: 0.5px solid #f9d5d5; }
    .role-seller { background: #e8f5e9; color: #1b5e20; border: 0.5px solid #c8e6c9; }
    .role-buyer { background: #e3f2fd; color: #0d47a1; border: 0.5px solid #bbdefb; }

    .status-badge-premium {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active { background: #eaf3de; color: #3b6d11; }
    .status-banned { background: #fcebeb; color: #a32d2d; }

    /* Actions */
    .btn-action-details {
        background: #3d2010;
        color: #f5e6d3;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s;
        box-shadow: 0 2px 6px rgba(61, 32, 16, 0.1);
    }

    .btn-action-details:hover {
        background: #5c3d22;
        color: #f5e6d3;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(61, 32, 16, 0.2);
    }

    .btn-action-ban {
        background: transparent;
        color: #a32d2d;
        border: 1px solid #f0c4c4;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

    .btn-action-ban:hover {
        background: #fcebeb;
        border-color: #a32d2d;
    }

    .btn-action-unban {
        background: transparent;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

    .btn-action-unban:hover {
        background: #e8f5e9;
        border-color: #2e7d32;
    }

    .table-user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .table-user-info span {
        font-weight: 600;
        color: #3d2010;
        display: block;
    }

    .table-user-info small {
        font-size: 11px;
        color: #887265;
    }

    @@media (max-width: 768px) {
        .premium-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            padding: 16px 20px;
        }
        .total-badge-premium {
            align-self: flex-start;
        }
        .filter-grid {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }
        .premium-select, .btn-clear-premium {
            width: 100%;
            box-sizing: border-box;
            justify-content: center;
        }
        .premium-card {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .premium-table {
            min-width: 800px;
        }
    }
</style>

<div class="users-container">
    <!-- Premium Header -->
    <div class="premium-header">
        <div class="premium-header-title">
            <h2>User Directories</h2>
            <p>Manage access, verify store status, and monitor accounts across all user profiles.</p>
        </div>
        <div class="total-badge-premium">
            Total Accounts: @Model.Users.Count
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: #e8f5e9; color: #1b5e20; padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-size: 14px; border: 1px solid #c8e6c9; display: flex; align-items: center; gap: 8px;">
            <i class="ti ti-circle-check" style="font-size: 18px;"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="background-color: #ffebee; color: #c62828; padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-size: 14px; border: 1px solid #ffcdd2; display: flex; align-items: center; gap: 8px;">
            <i class="ti ti-alert-triangle" style="font-size: 18px;"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Premium Card Table -->
    <div class="premium-card">
        <!-- Toolbar -->
        <div class="premium-toolbar">
            <form method="get" class="filter-grid">
                <div class="filter-item">
                    <label>Filter by Role</label>
                    <select name="role" class="premium-select" onchange="this.form.submit()">
                        <option value="">All Roles</option>
                        @if (Model.SelectedRole == "Admin")
                        {
                            <option value="Admin" selected>Admin</option>
                        }
                        else
                        {
                            <option value="Admin">Admin</option>
                        }
                        
                        @if (Model.SelectedRole == "Seller")
                        {
                            <option value="Seller" selected>Seller</option>
                        }
                        else
                        {
                            <option value="Seller">Seller</option>
                        }

                        @if (Model.SelectedRole == "Buyer")
                        {
                            <option value="Buyer" selected>Buyer</option>
                        }
                        else
                        {
                            <option value="Buyer">Buyer</option>
                        }
                    </select>
                </div>

                <div class="filter-item">
                    <label>Filter by Status</label>
                    <select name="status" class="premium-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @if (Model.SelectedStatus == "active")
                        {
                            <option value="active" selected>Active</option>
                        }
                        else
                        {
                            <option value="active">Active</option>
                        }

                        @if (Model.SelectedStatus == "inactive")
                        {
                            <option value="inactive" selected>Inactive</option>
                        }
                        else
                        {
                            <option value="inactive">Inactive</option>
                        }

                        @if (Model.SelectedStatus == "banned")
                        {
                            <option value="banned" selected>Banned</option>
                        }
                        else
                        {
                            <option value="banned">Banned</option>
                        }
                    </select>
                </div>

                <div style="margin-left: auto;">
                    <a href="@Url.Action("Index")" class="btn-clear-premium">
                        <i class="ti ti-refresh"></i> Reset Filters
                    </a>
                </div>
            </form>
        </div>

        <!-- Table -->
        <table class="premium-table">
            <thead>
                <tr>
                    <th style="width: 28%">User Details</th>
                    <th style="width: 25%">Contact Info</th>
                    <th style="width: 15%">Roles</th>
                    <th style="width: 18%">Banned Status</th>
                    <th style="width: 14%; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="table-user-cell">
                                    @if (!string.IsNullOrEmpty(user.ProfileImage))
                                    {
                                        <img src="@user.ProfileImage" class="avatar-img-premium" alt="@user.Name" />
                                    }
                                    else
                                    {
                                        <div class="avatar-circle-premium">
                                            @user.Name.Substring(0, Math.Min(2, user.Name.Length)).ToUpper()
                                        </div>
                                    }
                                    <div class="table-user-info">
                                        <span>@user.Name</span>
                                        <small>ID: @user.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-weight: 500; color: #3d2010;">@user.Email</span>
                                    <span style="font-size: 12px; color: #887265;">
                                        <i class="ti ti-phone" style="font-size: 11px;"></i> @(string.IsNullOrEmpty(user.PhoneNumber) ? "No Phone" : user.PhoneNumber)
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    @foreach (var r in user.Roles)
                                    {
                                        string roleClass = r switch
                                        {
                                            "Admin" => "role-admin",
                                            "Seller" => "role-seller",
                                            _ => "role-buyer"
                                        };
                                        <span class="role-badge-premium @roleClass">@r</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    @if (user.IsBanned)
                                    {
                                        <span class="status-badge-premium status-banned">
                                            <i class="ti ti-ban"></i> Banned
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge-premium status-active">
                                            <i class="ti ti-circle-check"></i> Active
                                        </span>
                                    }

                                    <!-- Quick Ban/Unban Toggle -->
                                    <form asp-action="ToggleBanStatus" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        @if (user.IsBanned)
                                        {
                                            <button type="submit" class="btn-action-unban" title="Click to Unban account">
                                                <i class="ti ti-check"></i> Unban
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn-action-ban" title="Click to Ban account">
                                                <i class="ti ti-ban"></i> Ban
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <a href="@Url.Action("Details", new { id = user.Id })" class="btn-action-details">
                                    <i class="ti ti-user"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: #887265; padding: 48px; font-size: 14px;">
                            <i class="ti ti-info-circle" style="font-size: 24px; display: block; margin-bottom: 8px; color: #d4c8bc;"></i>
                            No accounts match the selected filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
