@model HandoraMVC.ViewModels.UserDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"User Details - {Model.Name}";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    .details-container {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #2b1d15;
    }

    .back-link-premium {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #7a5433;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.2s;
    }

    .back-link-premium:hover {
        color: #3d2010;
    }

    /* Profile Header Card */
    .profile-header-card {
        background: linear-gradient(135deg, #3d2010 0%, #200f07 100%);
        color: #f5e6d3;
        padding: 30px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 24px;
        box-shadow: 0 8px 30px rgba(61, 32, 16, 0.15);
    }

    .profile-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .profile-header-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #c4956a;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .profile-header-avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 28px;
        color: #3d2010;
        background: linear-gradient(135deg, #f5e6d3 0%, #c4956a 100%);
        border: 3px solid #c4956a;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .profile-header-info h2 {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 6px 0;
        color: #ffffff;
        letter-spacing: -0.5px;
    }

    .profile-header-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        color: #c4956a;
    }

    .profile-header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Grid Layout */
    .details-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 24px;
    }

    @@media (max-width: 992px) {
        .details-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Cards */
    .details-card {
        background: #ffffff;
        border: 1px solid #e8dfd3;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(61, 32, 16, 0.02);
    }

    .details-card h3 {
        font-size: 15px;
        font-weight: 700;
        color: #3d2010;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 16px 0;
        border-bottom: 1.5px solid #f5ede4;
        padding-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Lists and Forms */
    .info-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .info-item span {
        font-size: 11px;
        font-weight: 600;
        color: #887265;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item p {
        font-size: 14px;
        font-weight: 500;
        color: #3d2010;
        margin: 0;
        word-break: break-all;
    }

    /* Stats Grid */
    .stats-layout-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card-premium {
        background: linear-gradient(135deg, #fbf9f6 0%, #f5ede4 100%);
        border: 1px solid #e8dfd3;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(61, 32, 16, 0.02);
    }

    .stat-card-premium-info span {
        font-size: 12px;
        font-weight: 600;
        color: #887265;
        text-transform: uppercase;
        display: block;
        margin-bottom: 6px;
    }

    .stat-card-premium-info h4 {
        font-size: 24px;
        font-weight: 700;
        color: #3d2010;
        margin: 0;
    }

    .stat-card-premium i {
        font-size: 28px;
        color: #c4956a;
    }

    /* Badges */
    .badge-details {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .badge-active { background: #e8f5e9; color: #1b5e20; border: 0.5px solid #c8e6c9; }
    .badge-banned { background: #fcebeb; color: #a32d2d; border: 0.5px solid #f9d5d5; }
    .badge-verified { background: #e3f2fd; color: #0d47a1; border: 0.5px solid #bbdefb; }
    .badge-unverified { background: #fff8e1; color: #f57f17; border: 0.5px solid #ffe082; }

    /* Tables */
    .details-table {
        width: 100%;
        border-collapse: collapse;
    }

    .details-table th {
        background-color: #fbf9f6;
        color: #7a6151;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        padding: 12px 16px;
        border-bottom: 1.5px solid #e8dfd3;
        text-align: left;
    }

    .details-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f0ebe4;
        font-size: 13px;
        color: #3d2010;
    }

    .details-table tr:last-child td {
        border-bottom: none;
    }

    .details-table tr:hover td {
        background-color: #faf7f4;
    }

    /* Reviews List */
    .review-item-premium {
        border-bottom: 1px solid #f0ebe4;
        padding: 16px 0;
    }

    .review-item-premium:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .review-item-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .review-stars {
        color: #ffb300;
        font-size: 13px;
        display: flex;
        gap: 2px;
    }

    .review-product-link {
        font-weight: 600;
        color: #7a5433;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.15s;
    }

    .review-product-link:hover {
        color: #3d2010;
    }

    .review-comment {
        font-size: 13.5px;
        color: #4a3c31;
        margin: 6px 0 0 0;
        line-height: 1.5;
        font-style: italic;
    }

    /* Address Cards */
    .address-box {
        background: #fbf9f6;
        border: 1px solid #e8dfd3;
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 12px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .address-box:last-child {
        margin-bottom: 0;
    }

    .address-box i {
        font-size: 18px;
        color: #c4956a;
        margin-top: 2px;
    }

    .address-box-content p {
        font-size: 13px;
        color: #3d2010;
        margin: 0 0 4px 0;
        font-weight: 500;
    }

    .address-box-content span {
        font-size: 11px;
        color: #887265;
        display: block;
    }

    /* Buttons */
    .btn-ban-details {
        background: #a32d2d;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        box-shadow: 0 3px 8px rgba(163, 45, 45, 0.25);
    }

    .btn-ban-details:hover {
        background: #801d1d;
        transform: translateY(-1px);
    }

    .btn-unban-details {
        background: #2e7d32;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        box-shadow: 0 3px 8px rgba(46, 125, 50, 0.25);
    }

    .btn-unban-details:hover {
        background: #1b5e20;
        transform: translateY(-1px);
    }
</style>

<div class="details-container">
    <!-- Back Link -->
    <a href="@Url.Action("Index")" class="back-link-premium">
        <i class="ti ti-arrow-left"></i> Back to User Directory
    </a>

    <!-- Profile Header Card -->
    <div class="profile-header-card">
        <div class="profile-header-left">
            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage" class="profile-header-avatar" alt="@Model.Name" />
            }
            else
            {
                <div class="profile-header-avatar-placeholder">
                    @Model.Name.Substring(0, Math.Min(2, Model.Name.Length)).ToUpper()
                </div>
            }
            <div class="profile-header-info">
                <h2>@Model.Name</h2>
                <div class="profile-header-meta">
                    <span class="badge-details badge-verified" style="background: rgba(255,255,255,0.15); color: #fff; border: none;">
                        @(Model.IsSeller ? "Seller Profile" : "Buyer Profile")
                    </span>
                    <span>•</span>
                    <span><i class="ti ti-calendar"></i> Joined @Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>

        <div class="profile-header-actions">
            <!-- Ban / Unban Form Action -->
            <form asp-action="ToggleBanStatus" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                @if (Model.IsBanned)
                {
                    <button type="submit" class="btn-unban-details">
                        <i class="ti ti-circle-check"></i> Lift Account Ban
                    </button>
                }
                else
                {
                    <button type="submit" class="btn-ban-details">
                        <i class="ti ti-ban"></i> Suspend/Ban Account
                    </button>
                }
            </form>

           
        </div>
    </div>

    <!-- Main Grid -->
    <div class="details-grid">
        <!-- Sidebar -->
        <div class="sidebar-column">
            <!-- Basic Profile Info -->
            <div class="details-card">
                <h3><i class="ti ti-id"></i> Account Profile</h3>
                <div class="info-list">
                    <div class="info-item">
                        <span>Email Address</span>
                        <p>@Model.Email</p>
                    </div>
                    <div class="info-item">
                        <span>Phone Number</span>
                        <p>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</p>
                    </div>
                    <div class="info-item">
                        <span>Bio Description</span>
                        <p style="font-style: italic;">@(string.IsNullOrEmpty(Model.Bio) ? "No personal bio available." : Model.Bio)</p>
                    </div>
                    <div class="info-item">
                        <span>Account Access</span>
                        <div>
                            @if (Model.IsBanned)
                            {
                                <span class="badge-details badge-banned"><i class="ti ti-ban"></i> BANNED / SUSPENDED</span>
                            }
                            else
                            {
                                <span class="badge-details badge-active"><i class="ti ti-circle-check"></i> ACTIVE</span>
                            }
                        </div>
                    </div>
                   
                </div>
            </div>

            <!-- Addresses Section (Only for Buyer) -->
            @if (!Model.IsSeller)
            {
                <div class="details-card">
                    <h3><i class="ti ti-map-pin"></i> Shipping Addresses</h3>
                    @if (Model.Addresses.Any())
                    {
                        @foreach (var addr in Model.Addresses)
                        {
                            <div class="address-box">
                                <i class="ti ti-map-pin"></i>
                                <div class="address-box-content">
                                    <p>@addr.AddressLine</p>
                                    <span>@addr.City, @addr.Country @(string.IsNullOrEmpty(addr.PostalCode) ? "" : $"- {addr.PostalCode}")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span style="font-size: 13px; color: #887265; font-style: italic; display: block; text-align: center; padding: 10px 0;">
                            No registered addresses.
                        </span>
                    }
                </div>
            }
        </div>

        <!-- Main Content (Dynamic) -->
        <div class="main-column">
            @if (!Model.IsSeller)
            {
                <!-- BUYER VIEW -->
                <!-- Stats -->
                <div class="stats-layout-grid">
                    <div class="stat-card-premium">
                        <div class="stat-card-premium-info">
                            <span>Orders Placed</span>
                            <h4>@Model.OrderCount</h4>
                        </div>
                        <i class="ti ti-shopping-cart"></i>
                    </div>

                    <div class="stat-card-premium">
                        <div class="stat-card-premium-info">
                            <span>Total Spent</span>
                            <h4>@Model.TotalSpent.ToString("C")</h4>
                        </div>
                        <i class="ti ti-cash"></i>
                    </div>
                </div>

                <!-- Recent Orders -->
                <div class="details-card">
                    <h3><i class="ti ti-shopping-bag"></i> Last 5 Orders</h3>
                    @if (Model.RecentOrders.Any())
                    {
                        <table class="details-table">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td style="font-family: monospace; font-weight: 600;">@order.Id.ToString().Substring(0, 8).ToUpper()</td>
                                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td style="font-weight: 600; color: #7a5433;">@order.Total.ToString("C")</td>
                                        <td>
                                            @{
                                                string badgeClass = order.Status switch
                                                {
                                                    "Delivered" => "badge-complete",
                                                    "Cancelled" => "badge-cancelled",
                                                    "Processing" => "badge-processing",
                                                    _ => "badge-pending"
                                                };
                                            }
                                            <span class="badge @badgeClass">@order.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div style="text-align: center; color: #887265; font-style: italic; padding: 20px 0; font-size: 13.5px;">
                            This user has not placed any orders yet.
                        </div>
                    }
                </div>

                <!-- Reviews Written -->
                <div class="details-card">
                    <h3><i class="ti ti-star"></i> Reviews Posted</h3>
                    @if (Model.Reviews.Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="review-item-premium">
                                    <div class="review-item-header">
                                        <a href="#" class="review-product-link">@review.ProductTitle</a>
                                        <span style="font-size: 11px; color: #887265;">@review.CreatedAt.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="review-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="ti ti-star-filled"></i>
                                            }
                                            else
                                            {
                                                <i class="ti ti-star"></i>
                                            }
                                        }
                                    </div>
                                    <p class="review-comment">"@review.Comment"</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; color: #887265; font-style: italic; padding: 20px 0; font-size: 13.5px;">
                            This user has not submitted any reviews.
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- SELLER VIEW -->
                @if (Model.HasShop)
                {
                    <!-- Stats Grid -->
                    <div class="stats-layout-grid">
                        <div class="stat-card-premium">
                            <div class="stat-card-premium-info">
                                <span>Gross Sales</span>
                                <h4>@Model.ShopTotalSales.ToString("C")</h4>
                            </div>
                            <i class="ti ti-cash"></i>
                        </div>

                        <div class="stat-card-premium">
                            <div class="stat-card-premium-info">
                                <span>Products Listed</span>
                                <h4>@Model.ShopProductCount</h4>
                            </div>
                            <i class="ti ti-package"></i>
                        </div>

                        <div class="stat-card-premium">
                            <div class="stat-card-premium-info">
                                <span>Orders Received</span>
                                <h4>@Model.ShopOrderCount</h4>
                            </div>
                            <i class="ti ti-shopping-bag"></i>
                        </div>
                    </div>

                    <!-- Shop Info Card -->
                    <div class="details-card">
                        <h3><i class="ti ti-store"></i> Shop Profile Details</h3>
                        <div style="display: flex; gap: 20px; align-items: flex-start; margin-bottom: 20px;">
                            <div style="flex: 1;">
                                <h4 style="font-size: 18px; font-weight: 700; color: #3d2010; margin: 0 0 6px 0;">@Model.ShopName</h4>
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                    <div class="review-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(Model.ShopRating))
                                            {
                                                <i class="ti ti-star-filled"></i>
                                            }
                                            else
                                            {
                                                <i class="ti ti-star"></i>
                                            }
                                        }
                                    </div>
                                    <span style="font-size: 13px; font-weight: 600; color: #3d2010;">@Model.ShopRating.ToString("F1") / 5.0 (@Model.ShopReviewCount reviews)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Products Added -->
                    <div class="details-card">
                        <h3><i class="ti ti-package"></i> Last 5 Products Added</h3>
                        @if (Model.RecentProducts.Any())
                        {
                            <table class="details-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Price</th>
                                        <th>Status</th>
                                        <th>Created Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prod in Model.RecentProducts)
                                    {
                                        <tr>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                    @if (!string.IsNullOrEmpty(prod.ImageUrl))
                                                    {
                                                        <img src="@prod.ImageUrl" style="width: 36px; height: 36px; border-radius: 6px; object-fit: cover; border: 1px solid #e8dfd3;" alt="@prod.TitleEn" />
                                                    }
                                                    else
                                                    {
                                                        <div style="width: 36px; height: 36px; border-radius: 6px; background: #f5ede4; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: #887265;">N/A</div>
                                                    }
                                                    <div>
                                                        <span style="font-weight: 600; display: block;">@prod.TitleEn</span>
                                                        <small style="color: #887265; font-size: 11px;">@prod.TitleAr</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="font-weight: 600;">
                                                @if (prod.DiscountPrice.HasValue)
                                                {
                                                    <span style="color: #a32d2d; margin-right: 4px;">@prod.DiscountPrice.Value.ToString("C")</span>
                                                    <span style="text-decoration: line-through; color: #887265; font-size: 11px;">@prod.Price.ToString("C")</span>
                                                }
                                                else
                                                {
                                                    <span>@prod.Price.ToString("C")</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    string badgeClass = prod.Status switch
                                                    {
                                                        "Active" => "badge-complete",
                                                        "Draft" => "badge-pending",
                                                        _ => "badge-cancelled"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@prod.Status</span>
                                            </td>
                                            <td>@prod.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div style="text-align: center; color: #887265; font-style: italic; padding: 20px 0; font-size: 13.5px;">
                                No products have been added to this store yet.
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="details-card" style="text-align: center; padding: 48px; border-style: dashed; border-width: 2px;">
                        <i class="ti ti-store-off" style="font-size: 48px; color: #d4c8bc; margin-bottom: 12px; display: block;"></i>
                        <h4 style="font-size: 16px; font-weight: 700; color: #3d2010; margin-bottom: 4px;">No Store Registered</h4>
                        <p style="font-size: 13.5px; color: #887265; margin: 0;">This seller profile has not initialized or created a shop profile yet.</p>
                    </div>
                }
            }
        </div>
    </div>
</div>
