@model HandoraMVC.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .alert-success {
        background-color: #eaf3de;
        color: #3b6d11;
        border: 0.5px solid #c4d7b2;
    }
    .alert-danger {
        background-color: #fcebeb;
        color: #a32d2d;
        border: 0.5px solid #f0c4c4;
    }
    .status-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .order-actions-card {
        background: #fff;
        border: 0.5px solid #e8e0d8;
        border-radius: 10px;
        padding: 16px;
    }
    .order-actions-card h3 {
        font-size: 12px;
        font-weight: 500;
        color: #888;
        text-transform: uppercase;
    .responsive-details-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }
    @@media (max-width: 992px) {
        .responsive-details-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (max-width: 480px) {
        .responsive-details-grid {
            grid-template-columns: 1fr;
        }
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
        .page-header a, .page-header span {
            width: 100%;
            text-align: center;
        }
    }
</style>
<div class="page-header">
    <a asp-action="Index" class="btn-secondary">← Back</a>
    <h2>Order Details</h2>
    <span class="status-badge @Model.Status.ToLower()">@Model.Status</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="ti ti-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="ti ti-alert-triangle"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="details-grid responsive-details-grid">
    <div class="detail-card">
        <h3>Customer</h3>
        <p>@Model.BuyerEmail</p>
        <p>@Model.FullName</p>
        <p>@Model.Street, @Model.City, @Model.Country</p>
    </div>

    <div class="detail-card">
        <h3>Delivery</h3>
        <p>@Model.DeliveryMethodName</p>
        <p>Cost: @Model.DeliveryMethodCost.ToString("C")</p>
        @if (!string.IsNullOrEmpty(Model.CouponCode))
        {
            <p>Coupon: <strong>@Model.CouponCode</strong></p>
        }
    </div>

    <div class="detail-card">
        <h3>Payment</h3>
        <p>Status: <span class="status-badge @Model.PaymentStatus.ToLower()">@Model.PaymentStatus</span></p>
        <p>Subtotal: @Model.SubTotal.ToString("C")</p>
        @if (Model.DiscountAmount.HasValue)
        {
            <p>Discount: -@Model.DiscountAmount.Value.ToString("C")</p>
        }
        <p><strong>Total: @Model.Total.ToString("C")</strong></p>
    </div>
    <div class="order-actions-card">
        <h3>Order Control</h3>
        @if (Model.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase) || 
             Model.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || 
             Model.Status.Equals("Refunded", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert alert-success" style="margin: 0; padding: 10px; font-size: 11px;">
                <i class="ti ti-lock"></i>
                <span>This order is completed (@Model.Status) and is read-only.</span>
            </div>
        }
        else
        {
            <form asp-action="UpdateStatus" method="post" class="status-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-group" style="margin-bottom: 0;">
                    <select name="status" class="filter-select" style="width: 100%; height: 36px; margin-bottom: 10px;">
                        <option value="Delivered">Delivered</option>
                    </select>
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; height: 36px;">
                    <i class="ti ti-refresh"></i> Update Status
                </button>
            </form>
        }
    </div>
</div>

<div class="table-card">
    <h3>Items</h3>
    <table>
        <thead>
            <tr>
                <th>Product</th>
                <th>Seller</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <div class="product-cell">
                            @if (!string.IsNullOrEmpty(item.PictureUrl))
                            {
                                <img src="@item.PictureUrl" alt="@item.ProductName" class="cat-img" />
                            }
                            <span>@item.ProductName</span>
                        </div>
                    </td>
                    <td>
                        <div style="display: flex; flex-direction: column; gap: 2px;">
                            @if (!string.IsNullOrEmpty(item.ShopName))
                            {
                                <strong style="color: #2c3e50;">@item.ShopName</strong>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                            <span style="font-size: 11px; color: #7f8c8d; line-height: 1.3;">
                                <strong>Name:</strong> @(string.IsNullOrEmpty(item.SellerName) ? "N/A" : item.SellerName)<br />
                                <strong>Email:</strong> @(string.IsNullOrEmpty(item.SellerEmail) ? "N/A" : item.SellerEmail)
                                @if (!string.IsNullOrEmpty(item.SellerPhone))
                                {
                                    <br /><strong>Phone:</strong> @item.SellerPhone
                                }
                            </span>
                        </div>
                    </td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@item.Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <div class="detail-card">
        <h3>Notes</h3>
        <p>@Model.Notes</p>
    </div>
}