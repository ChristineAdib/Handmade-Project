<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Handora Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HandoraMVC.styles.css" asp-append-version="true" />
    <style>
        .admin-layout { display: flex; min-height: 80vh; }
        .admin-sidebar { width: 220px; background: #f8f9fa; padding: 1rem; border-right: 1px solid #dee2e6; }
        .admin-main { flex: 1; padding: 1rem; }
        .admin-nav a { display: block; padding: .25rem 0; color: #333; }
        .page-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Handora Admin</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid admin-layout">
        <aside class="admin-sidebar">
            <nav class="admin-nav">
                <a asp-controller="Categories" asp-action="Index">Categories</a>
                <a asp-controller="Products" asp-action="Index">Products</a>
                <a asp-controller="Orders" asp-action="Index">Orders</a>
            </nav>
        </aside>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - HandoraMVC Admin
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>