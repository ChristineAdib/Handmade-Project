@inject HandoraApplication.IServices.INotificationService NotificationService
@inject Microsoft.AspNetCore.Identity.UserManager<HandoraDomain.Models.AppUser.User> UserManager
@inject HandoraApplication.Helpers.AuthHelper.JwtHelper JwtHelper
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Security.Claims
@{
    var unreadNotifCount = 0;
    IReadOnlyList<HandoraApplication.DTOs.NotificationsDto.NotificationDto> recentNotifications = new List<HandoraApplication.DTOs.NotificationsDto.NotificationDto>();
    var jwtToken = "";
    var debugException = "";
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                unreadNotifCount = await NotificationService.GetUnreadCountAsync(userId);
            }
            catch (System.Exception ex)
            {
                debugException += "UnreadCount: " + ex.Message + " | ";
            }

            try
            {
                var pagedResult = await NotificationService.GetUserNotificationsAsync(userId, new HandoraApplication.DTOs.Common.PaginationQueryDto { PageNumber = 1, PageSize = 5 });
                recentNotifications = pagedResult.Items;
            }
            catch (System.Exception ex)
            {
                debugException += "GetUserNotifications: " + ex.Message + " | ";
            }

            try
            {
                var user = await UserManager.FindByIdAsync(userId);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);
                    var (token, _) = JwtHelper.GenerateToken(user, roles);
                    jwtToken = token;
                }
            }
            catch (System.Exception ex)
            {
                debugException += "TokenGen: " + ex.Message + " | ";
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Handora Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.19.0/dist/tabler-icons.min.css" />
</head>
<body>
    <div class="shell">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <span>Handaura</span>
                <small>Admin Dashboard</small>
            </div>
            <nav class="nav-section">
                <div class="nav-label">Main</div>
                <a asp-controller="Admin" asp-action="Analytics"
                   class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                    <i class="ti ti-layout-dashboard" aria-hidden="true"></i> Overview
                </a>
                <a asp-controller="Orders" asp-action="Index"
                   class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="ti ti-shopping-bag" aria-hidden="true"></i> Orders
                </a>
                <a asp-controller="Categories" asp-action="Index"
                   class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="ti ti-category" aria-hidden="true"></i> Categories
                </a>
                <a asp-controller="Products" asp-action="Index"
                   class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                    <i class="ti ti-package" aria-hidden="true"></i> Products
                </a>
                <a asp-controller="AdminUsers" asp-action="Index"
                   class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUsers" ? "active" : "")">
                    <i class="ti ti-users" aria-hidden="true"></i> Users
                </a>
                <a asp-controller="Shops" asp-action="Index"
                   class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shops" ? "active" : "")">
                    <i class="ti ti-store" aria-hidden="true"></i> Shops
                </a>

             
            </nav>
            <div class="nav-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-item" style="width:100%;border:none;background:none;cursor:pointer;">
                        <i class="ti ti-logout" aria-hidden="true"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main -->
        <div class="main">
            <header class="topbar">
                <span class="topbar-title">@ViewData["Title"]</span>
                <div class="topbar-right">
                    <div class="notification-dropdown-wrapper">
                        <button class="topbar-icon-btn" id="notifBell" aria-label="Notifications">
                            <i class="ti ti-bell" aria-hidden="true"></i>
                            @if (unreadNotifCount > 0)
                            {
                                <span class="notif-badge">@unreadNotifCount</span>
                            }
                        </button>
                        <div class="notif-menu" id="notifMenu">
                            <div class="notif-menu-header">
                                <span>Notifications</span>
                                <span id="markAllReadWrapper" style="display: @(unreadNotifCount > 0 ? "inline" : "none")">
                                    <form asp-controller="Admin" asp-action="MarkAllNotificationsAsRead" method="post" style="display:inline; margin:0; padding:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="mark-all-read-btn">Mark all read</button>
                                    </form>
                                </span>
                            </div>
                            <div class="notif-menu-body">
                                @if (!recentNotifications.Any())
                                {
                                    <div class="notif-item-empty">No notifications yet</div>
                                }
                                else
                                {
                                    @foreach (var notif in recentNotifications)
                                    {
                                        <a href="/Products" class="notif-item @(notif.IsRead ? "" : "unread")">
                                            <div class="notif-item-title">@notif.TitleEn</div>
                                            <div class="notif-item-desc">@notif.MessageEn</div>
                                            <div class="notif-item-time">@notif.CreatedAt.ToString("g")</div>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="avatar">A</div>
                </div>
            </header>
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)   @* ← ضيفي السطر ده *@

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var bell = document.getElementById('notifBell');
            var menu = document.getElementById('notifMenu');
            if (bell && menu) {
                bell.addEventListener('click', function (e) {
                    e.stopPropagation();
                    menu.classList.toggle('show');
                });
                document.addEventListener('click', function (e) {
                    if (!menu.contains(e.target) && e.target !== bell) {
                        menu.classList.remove('show');
                    }
                });
            }

            var token = '@jwtToken';
            if (token) {
                var apiBaseUrl = '@Configuration["ApiBaseUrl"]';
                if (!apiBaseUrl) {
                    apiBaseUrl = 'http://localhost:5216/';
                }
                if (!apiBaseUrl.endsWith('/')) {
                    apiBaseUrl += '/';
                }

                var connection = new signalR.HubConnectionBuilder()
                    .withUrl(apiBaseUrl + 'hubs/notifications', {
                        accessTokenFactory: () => token
                    })
                    .withAutomaticReconnect()
                    .build();

                connection.on('ReceiveNotification', function (notification) {
                    var menuBody = document.querySelector('.notif-menu-body');
                    if (menuBody) {
                        var emptyDiv = menuBody.querySelector('.notif-item-empty');
                        if (emptyDiv) {
                            emptyDiv.remove();
                        }

                        var dateOptions = {
                            year: 'numeric',
                            month: 'numeric',
                            day: 'numeric',
                            hour: 'numeric',
                            minute: 'numeric',
                            hour12: true,
                            timeZone: 'Africa/Cairo'
                        };
                        var dateStr = new Date(notification.createdAt).toLocaleString('en-US', dateOptions);

                        var newNotifHtml = `
                            <a href="/Products" class="notif-item unread">
                                <div class="notif-item-title">${notification.titleEn}</div>
                                <div class="notif-item-desc">${notification.messageEn}</div>
                                <div class="notif-item-time">${dateStr}</div>
                            </a>
                        `;
                        menuBody.insertAdjacentHTML('afterbegin', newNotifHtml);

                        var items = menuBody.querySelectorAll('.notif-item');
                        if (items.length > 5) {
                            for (var i = 5; i < items.length; i++) {
                                items[i].remove();
                            }
                        }
                    }
                });

                connection.on('UnreadCountUpdated', function (count) {
                    var bell = document.getElementById('notifBell');
                    if (bell) {
                        var badge = bell.querySelector('.notif-badge');
                        if (count > 0) {
                            if (badge) {
                                badge.textContent = count;
                            } else {
                                badge = document.createElement('span');
                                badge.className = 'notif-badge';
                                badge.textContent = count;
                                bell.appendChild(badge);
                            }
                        } else {
                            if (badge) {
                                badge.remove();
                            }
                        }
                    }
                    var wrapper = document.getElementById('markAllReadWrapper');
                    if (wrapper) {
                        wrapper.style.display = count > 0 ? 'inline' : 'none';
                    }
                });

                connection.start().catch(err => console.error('SignalR Connection Error: ', err));
            }
        });
    </script>
</body>
</html>
