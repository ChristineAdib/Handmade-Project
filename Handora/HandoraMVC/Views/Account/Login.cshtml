@model HandoraMVC.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Handora — Admin Login</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.19.0/dist/tabler-icons.min.css" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                background: #f5f0eb;
                overflow: hidden;
            }

            /* ══ Left Panel ══════════════════════════════════════ */
            .login-left {
                width: 420px;
                flex-shrink: 0;
                background: #3d2010;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 52px 44px;
                position: relative;
                overflow: hidden;
            }

            /* floating circles */
            .circle {
                position: absolute;
                border-radius: 50%;
                border: 1.5px solid rgba(196,149,106,.55);
                background: rgba(196,149,106,.06);
                animation: floatCircle 6s ease-in-out infinite;
            }

            .circle-1 {
                width: 340px;
                height: 340px;
                top: -100px;
                right: -100px;
                animation-delay: 0s;
                opacity: .7;
            }

            .circle-2 {
                width: 200px;
                height: 200px;
                bottom: 80px;
                left: -70px;
                animation-delay: 2s;
                opacity: .85;
            }

            .circle-3 {
                width: 100px;
                height: 100px;
                top: 40%;
                right: 30px;
                animation-delay: 4s;
                opacity: 1;
            }

            @@keyframes floatCircle {
                0%, 100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-12px);
                }
            }

            /* floating dots grid */
            .dots-grid {
                position: absolute;
                bottom: 100px;
                right: 30px;
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 8px;
            }

                .dots-grid span {
                    width: 4px;
                    height: 4px;
                    border-radius: 50%;
                    background: rgba(196,149,106,.25);
                    display: block;
                }

            .brand {
                position: relative;
                z-index: 1;
            }

                .brand h1 {
                    color: #f5e6d3;
                    font-size: 24px;
                    font-weight: 700;
                    letter-spacing: .5px;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                .brand p {
                    color: #c4956a;
                    font-size: 12px;
                    margin-top: 5px;
                    letter-spacing: .08em;
                    text-transform: uppercase;
                }

            .brand-icon {
                width: 40px;
                height: 40px;
                background: rgba(196,149,106,.2);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
            }

            .left-mid {
                position: relative;
                z-index: 1;
            }

                .left-mid h2 {
                    color: #f5e6d3;
                    font-size: 28px;
                    font-weight: 700;
                    line-height: 1.35;
                    margin-bottom: 14px;
                }

                    .left-mid h2 span {
                        color: #c4956a;
                    }

                .left-mid p {
                    color: rgba(245,230,211,.45);
                    font-size: 13px;
                    line-height: 1.7;
                }

            .left-bottom {
                position: relative;
                z-index: 1;
                display: flex;
                gap: 6px;
            }

                .left-bottom span {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: rgba(196,149,106,.3);
                    transition: .3s;
                }

                    .left-bottom span:first-child {
                        background: #c4956a;
                        width: 22px;
                        border-radius: 4px;
                    }

            /* ══ Right Panel ═════════════════════════════════════ */
            .login-right {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 24px;
                position: relative;
            }

                /* subtle bg pattern */
                .login-right::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(circle, rgba(196,149,106,.07) 1px, transparent 1px);
                    background-size: 28px 28px;
                    pointer-events: none;
                }

            .login-box {
                width: 100%;
                max-width: 370px;
                position: relative;
                z-index: 1;
                animation: fadeUp .5s ease both;
            }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .login-box .head {
                margin-bottom: 28px;
            }

                .login-box .head h2 {
                    font-size: 22px;
                    font-weight: 700;
                    color: #1b1c1c;
                }

                .login-box .head p {
                    font-size: 13px;
                    color: #888;
                    margin-top: 4px;
                }

            /* ── Fields ── */
            .field {
                margin-bottom: 16px;
            }

                .field label {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    color: #7a5433;
                    text-transform: uppercase;
                    letter-spacing: .07em;
                    margin-bottom: 7px;
                }

            .input-wrap {
                position: relative;
            }

                .input-wrap .fi {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #c4956a;
                    font-size: 16px;
                    pointer-events: none;
                    transition: color .2s;
                }

                .input-wrap input {
                    width: 100%;
                    padding: 11px 40px 11px 40px;
                    border: 0.5px solid #d4c8bc;
                    border-radius: 10px;
                    font-size: 13px;
                    font-family: inherit;
                    background: #fff;
                    color: #1b1c1c;
                    outline: none;
                    transition: border .2s, box-shadow .2s;
                }

                    .input-wrap input:focus {
                        border-color: #c4956a;
                        box-shadow: 0 0 0 3px rgba(196,149,106,.13);
                    }

                        .input-wrap input:focus ~ .fi,
                        .input-wrap:focus-within .fi {
                            color: #7a5433;
                        }

            .eye-btn {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: #bbb;
                font-size: 16px;
                padding: 0;
                transition: color .15s;
            }

                .eye-btn:hover {
                    color: #7a5433;
                }

            /* field error */
            .field-err {
                color: #a32d2d;
                font-size: 11px;
                margin-top: 5px;
                display: block;
                min-height: 16px;
            }

            /* validation summary */
            .val-box {
                background: #fcebeb;
                border: 0.5px solid #f0c4c4;
                border-radius: 10px;
                padding: 11px 14px;
                font-size: 13px;
                color: #a32d2d;
                margin-bottom: 18px;
                display: flex;
                align-items: flex-start;
                gap: 9px;
                animation: fadeUp .3s ease;
            }

                .val-box i {
                    flex-shrink: 0;
                    margin-top: 1px;
                    font-size: 16px;
                }

                .val-box ul {
                    list-style: none;
                }

            /* remember row */
            .remember-row {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 13px;
                color: #555;
                margin-bottom: 22px;
                cursor: pointer;
                user-select: none;
            }

            /* custom checkbox */
            .custom-cb {
                display: none;
            }

            .cb-box {
                width: 18px;
                height: 18px;
                border: 0.5px solid #d4c8bc;
                border-radius: 5px;
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: .2s;
                flex-shrink: 0;
            }

            .custom-cb:checked + .cb-box {
                background: #3d2010;
                border-color: #3d2010;
            }

                .custom-cb:checked + .cb-box::after {
                    content: '✓';
                    color: #f5e6d3;
                    font-size: 11px;
                    font-weight: 700;
                }

            /* submit btn */
            .btn-login {
                width: 100%;
                padding: 12px;
                background: #3d2010;
                color: #f5e6d3;
                border: none;
                border-radius: 10px;
                font-size: 14px;
                font-weight: 600;
                font-family: inherit;
                cursor: pointer;
                letter-spacing: .03em;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                transition: background .2s, transform .1s, box-shadow .2s;
                position: relative;
                overflow: hidden;
            }

                .btn-login::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(135deg, rgba(196,149,106,.15) 0%, transparent 60%);
                    opacity: 0;
                    transition: opacity .3s;
                }

                .btn-login:hover {
                    background: #5c3d22;
                    box-shadow: 0 4px 14px rgba(61,32,16,.3);
                }

                    .btn-login:hover::before {
                        opacity: 1;
                    }

                .btn-login:active {
                    transform: scale(.98);
                }

            /* ripple */
            .ripple {
                position: absolute;
                border-radius: 50%;
                background: rgba(255,255,255,.2);
                transform: scale(0);
                animation: ripple .5s linear;
                pointer-events: none;
            }

            @@keyframes ripple {
                to {
                    transform: scale(4);
                    opacity: 0;
                }
            }

            /* spinner inside button */
            .btn-spinner {
                display: none;
            }

                .btn-spinner.show {
                    display: inline-block;
                    animation: spin .6s linear infinite;
                }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            @@media (max-width: 768px) {
                body {
                    flex-direction: column;
                    overflow-y: auto;
                }
                .login-left {
                    display: none;
                }
                .login-right {
                    min-height: 100vh;
                    padding: 30px 16px;
                }
            }
    </style>
</head>
<body>

    <!-- ══ Left Panel ══ -->
    <div class="login-left">
        <div class="circle circle-1"></div>
        <div class="circle circle-2"></div>
        <div class="circle circle-3"></div>
        <div class="dots-grid">
            @for (int i = 0; i < 16; i++)
            {
                <span></span>
            }
        </div>

        <div class="brand">
            <h1>
                <div class="brand-icon">🏺</div>
                Handora
            </h1>
            <p>Admin Dashboard</p>
        </div>

        <div class="left-mid">
            <h2>Manage your<br /><span>creative marketplace</span><br />with ease.</h2>
            <p>Track sales, monitor sellers, and grow the handmade community — all from one place.</p>
        </div>

        <div class="left-bottom">
            <span></span><span></span><span></span>
        </div>
    </div>

    <!-- ══ Right Panel ══ -->
    <div class="login-right">
        <div class="login-box">

            <div class="head">
                <h2>Welcome back 👋</h2>
                <p>Sign in to your admin account to continue</p>
            </div>

            @* Validation errors *@
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
            {
                <div class="val-box">
                    <i class="ti ti-alert-circle"></i>
                    <ul>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email -->
                <div class="field">
                    <label asp-for="Email">Email Address</label>
                    <div class="input-wrap">
                        <i class="ti ti-mail fi"></i>
                        <input asp-for="Email"
                               type="email"
                               placeholder="admin@handora.com"
                               autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-err"></span>
                </div>

                <!-- Password -->
                <div class="field">
                    <label asp-for="Password">Password</label>
                    <div class="input-wrap">
                        <i class="ti ti-lock fi"></i>
                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                        <button type="button" class="eye-btn" id="eyeBtn" tabindex="-1">
                            <i class="ti ti-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-err"></span>
                </div>

                <!-- Remember me -->
                <label class="remember-row">
                    <input class="custom-cb" asp-for="RememberMe" type="checkbox" />
                    <span class="cb-box"></span>
                    Keep me signed in
                </label>

                <button type="submit" class="btn-login" id="submitBtn">
                    <i class="ti ti-login" id="btnIcon"></i>
                    <i class="ti ti-loader btn-spinner" id="btnSpinner"></i>
                    <span id="btnText">Sign In</span>
                </button>
            </form>

        </div>
    </div>

    <script>
            // ── Toggle password visibility ────────────────────────────
            document.getElementById('eyeBtn').addEventListener('click', function () {
                const input = document.getElementById('passwordInput');
                const icon  = document.getElementById('eyeIcon');
                input.type  = input.type === 'password' ? 'text' : 'password';
                icon.className = input.type === 'password' ? 'ti ti-eye' : 'ti ti-eye-off';
            });

            // ── Ripple effect on button ───────────────────────────────
            document.getElementById('submitBtn').addEventListener('click', function (e) {
                const btn    = this;
                const ripple = document.createElement('span');
                const rect   = btn.getBoundingClientRect();
                const size   = Math.max(rect.width, rect.height);
                ripple.className = 'ripple';
                ripple.style.cssText = `width:${size}px;height:${size}px;left:${e.clientX-rect.left-size/2}px;top:${e.clientY-rect.top-size/2}px`;
                btn.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });

            // ── Loading spinner on submit ─────────────────────────────
            document.getElementById('loginForm').addEventListener('submit', function () {
                document.getElementById('btnIcon').style.display    = 'none';
                document.getElementById('btnText').textContent      = 'Signing in...';
                document.getElementById('btnSpinner').classList.add('show');
                document.getElementById('submitBtn').disabled       = true;
            });
    </script>

</body>
</html>
