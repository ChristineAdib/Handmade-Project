@model HandoraApplication.IServices.PagedList<HandoraApplication.IServices.AdminAiGenerationDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "AI Generations Management";

    var search = ViewData["Search"] as string;
    var provider = ViewData["Provider"] as string;
}

<style>
    :root {
        --br: #3d2010;
        --border: #e8e0d8;
        --text: #1b1c1c;
        --muted: #888;
    }

    .ai-container {
        animation: fadeUp 0.4s ease both;
    }

    .generations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        margin-top: 16px;
    }

    .ai-card-item {
        background: #fff;
        border: 0.5px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 4px 12px rgba(61,32,16,0.02);
    }

    .ai-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 8px;
    }

    .ai-meta {
        font-size: 12px;
        color: var(--text);
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .meta-line {
        display: flex;
        justify-content: space-between;
        border-bottom: 0.5px solid #f9f5f0;
        padding-bottom: 4px;
    }

    .meta-lbl { color: var(--muted); }
    .meta-val { font-weight: 600; }
</style>

<div class="ai-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 20px; font-weight: 600; color: var(--br);">AI Generation History</h2>
    </div>

    <!-- Filters -->
    <form method="get" class="filter-bar" style="background:#fff; padding:16px; border-radius:12px; border:0.5px solid var(--border); display:flex; gap:12px;">
        <input type="text" name="search" value="@search" placeholder="Search prompt text, request ID..." class="filter-input" style="flex:1;" />
        <select name="provider" class="filter-input">
            <option value="">-- All Providers --</option>
            <option value="GoogleAIStudio" selected="@(provider == "GoogleAIStudio")">Google AI Studio</option>
            <option value="OpenAI" selected="@(provider == "OpenAI")">OpenAI</option>
            <option value="MockProvider" selected="@(provider == "MockProvider")">Mock/Fallback Provider</option>
        </select>
        <button type="submit" class="btn-search">Search Logs</button>
        <a asp-action="AiGenerations" class="ptab" style="text-decoration:none;">Clear</a>
    </form>

    <!-- Grid items -->
    @if (!Model.Items.Any())
    {
        <div class="an-card" style="text-align:center; padding:48px; color: var(--muted); margin-top:20px;">
            No AI generation logs found.
        </div>
    }
    else
    {
        <div class="generations-grid">
            @foreach (var d in Model.Items)
            {
                <div class="ai-card-item">
                    <img src="@d.GeneratedImageUrl" alt="AI Generated Design" class="ai-image" />
                    <div class="ai-meta">
                        <div class="meta-line">
                            <span class="meta-lbl">Request Reference</span>
                            <a href="/AdminCustomStudio/Details/@d.RequestId" class="meta-val" style="color: var(--lt); text-decoration:none; font-family:monospace;">
                                @d.RequestId.ToString().Substring(0, 8)...
                            </a>
                        </div>
                        <div class="meta-line">
                            <span class="meta-lbl">AI Provider</span>
                            <span class="meta-val">@d.Provider</span>
                        </div>
                        <div class="meta-line">
                            <span class="meta-lbl">Response Time</span>
                            <span class="meta-val">@d.GenerationTimeSeconds Seconds</span>
                        </div>
                        <div class="meta-line">
                            <span class="meta-lbl">Prompt Length</span>
                            <span class="meta-val">@d.PromptLength Chars</span>
                        </div>
                        <div class="meta-line">
                            <span class="meta-lbl">Selection Status</span>
                            <span class="meta-val">@d.GenerationStatus</span>
                        </div>
                        <div class="meta-line">
                            <span class="meta-lbl">AI Match Score</span>
                            <span class="meta-val">@Math.Round(d.MatchingScore * 100)%</span>
                        </div>
                        <div class="meta-line">
                            <span class="meta-lbl">Attempts Count</span>
                            <span class="meta-val">@d.GenerationAttempts / 2</span>
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; margin-top:8px;">
                        <a href="@d.GeneratedImageUrl" target="_blank" class="btn-page" style="flex:1; text-align:center; margin-right:4px;">View Fullscreen</a>
                        <a href="@d.GeneratedImageUrl" download class="btn-page" style="flex:1; text-align:center;">Download</a>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <div class="pagination">
            <span>Showing Page @Model.PageNumber of @Model.TotalPages (Total @Model.TotalCount Logs)</span>
            <div style="display: flex; gap: 8px;">
                <a href="@Url.Action("AiGenerations", new { provider, search, pageNumber = Model.PageNumber - 1 })" 
                   class="btn-page @(Model.HasPreviousPage ? "" : "disabled")">Previous</a>
                <a href="@Url.Action("AiGenerations", new { provider, search, pageNumber = Model.PageNumber + 1 })" 
                   class="btn-page @(Model.HasNextPage ? "" : "disabled")">Next</a>
            </div>
        </div>
    }
</div>
