@model List<HandoraApplication.IServices.AdminArtisanDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Artisan Custom Studio Performance";
}

<style>
    :root {
        --br: #3d2010;
        --border: #e8e0d8;
        --text: #1b1c1c;
        --muted: #888;
        --green: #3b6d11;
        --lt: #c4956a;
    }

    .artisan-container {
        animation: fadeUp 0.4s ease both;
    }
</style>

<div class="artisan-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 20px; font-weight: 600; color: var(--br);">Artisan Performance Analytics</h2>
    </div>

    <!-- Table -->
    <div class="an-card" style="padding:0; overflow:hidden;">
        <table class="an-table">
            <thead>
                <tr>
                    <th>Artisan Shop</th>
                    <th>Owner / Seller</th>
                    <th>Match Count</th>
                    <th>Bid Acceptance Rate</th>
                    <th>Project Completion Rate</th>
                    <th>Average Rating</th>
                    <th>Avg Delivery Time</th>
                    <th>Completed Projects</th>
                    <th class="r">Total Revenue</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding: 24px; color: var(--muted);">No seller analytics available for Custom Studio yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <strong>@s.ShopName</strong>
                            </td>
                            <td>@s.OwnerName</td>
                            <td>@s.RequestsMatchedCount Matchings</td>
                            <td>
                                <span style="font-weight: 600; color: var(--br);">@s.OfferAcceptanceRate%</span>
                            </td>
                            <td>
                                <span style="font-weight: 600; color: var(--green);">@s.ProjectCompletionRate%</span>
                            </td>
                            <td>
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <i class="ti ti-star-filled" style="color: gold; font-size:12px;"></i>
                                    <span>@s.AverageRating.ToString("F1")</span>
                                </div>
                            </td>
                            <td>@s.AverageDeliveryTimeDays Days</td>
                            <td>@s.CompletedProjectsCount Completed</td>
                            <td class="r" style="font-weight: 700; color: var(--green);">
                                @s.TotalCustomRevenue.ToString("C")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
