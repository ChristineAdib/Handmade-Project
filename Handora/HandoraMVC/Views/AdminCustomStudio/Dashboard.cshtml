@model HandoraApplication.IServices.AdminCustomStudioDashboardDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Custom Studio Dashboard";
}

<style>
    :root {
        --br: #3d2010;
        --md: #7a5433;
        --lt: #c4956a;
        --cream: #f5e6d3;
        --bg: #f5f0eb;
        --card: #ffffff;
        --border: #e8e0d8;
        --text: #1b1c1c;
        --muted: #888;
        --green: #3b6d11;
        --green-bg: #eaf3de;
        --red: #a32d2d;
        --red-bg: #fcebeb;
    }

    .dashboard-container {
        animation: fadeUp 0.4s ease both;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: var(--card);
        border: 0.5px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(61,32,16,0.06);
    }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .kpi-icon.brown { background: #faf0e6; color: var(--br); }
    .kpi-icon.green { background: var(--green-bg); color: var(--green); }
    .kpi-icon.red { background: var(--red-bg); color: var(--red); }
    .kpi-icon.gold { background: #fdf5e6; color: var(--lt); }

    .kpi-content {
        display: flex;
        flex-direction: column;
    }

    .kpi-label {
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }

    .kpi-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text);
    }

    .stats-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .card-panel {
        background: var(--card);
        border: 0.5px solid var(--border);
        border-radius: 12px;
        padding: 24px;
    }

    .panel-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--br);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .trend-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .trend-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background: #faf8f5;
        border-radius: 8px;
        border: 0.5px solid #f0e6dc;
    }

    .trend-name {
        font-weight: 500;
        color: var(--text);
    }

    .trend-value {
        font-weight: 700;
        color: var(--br);
    }
</style>

<div class="dashboard-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 20px; font-weight: 600; color: var(--br);">Studio Overview</h2>
        <div style="display: flex; gap: 8px;">
            <a asp-action="ExportRequests" class="ptab"><i class="ti ti-download"></i> Export Requests</a>
            <a asp-action="ExportProjects" class="ptab"><i class="ti ti-download"></i> Export Projects</a>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon brown">
                <i class="ti ti-git-pull-request"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Total Requests</span>
                <span class="kpi-value">@Model.TotalRequests</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon gold">
                <i class="ti ti-calendar"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Requests Today</span>
                <span class="kpi-value">@Model.RequestsToday</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon brown">
                <i class="ti ti-calendar-event"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">This Month</span>
                <span class="kpi-value">@Model.RequestsThisMonth</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon green">
                <i class="ti ti-circle-check"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Completed Projects</span>
                <span class="kpi-value">@Model.CompletedProjects</span>
            </div>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon gold">
                <i class="ti ti-loader"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Pending Offers</span>
                <span class="kpi-value">@Model.PendingOffers</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon green">
                <i class="ti ti-coin"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Accepted Offers</span>
                <span class="kpi-value">@Model.AcceptedOffers</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon red">
                <i class="ti ti-trash"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Cancelled Projects</span>
                <span class="kpi-value">@Model.CancelledProjects</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon green">
                <i class="ti ti-percentage"></i>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">Conversion Rate</span>
                <span class="kpi-value">@Model.ConversionRatePercent%</span>
            </div>
        </div>
    </div>

    <!-- Performance Details -->
    <div class="stats-layout">
        <div class="card-panel">
            <h3 class="panel-title"><i class="ti ti-trending-up"></i> Performance Metrics</h3>
            <div class="trend-list">
                <div class="trend-item">
                    <span class="trend-name">Average Project Completion Time</span>
                    <span class="trend-value">@Model.AvgCompletionTimeDays Days</span>
                </div>
                <div class="trend-item">
                    <span class="trend-name">Average Proposed Offer Price</span>
                    <span class="trend-value">@Model.AvgOfferPrice EGP</span>
                </div>
                <div class="trend-item">
                    <span class="trend-name">Average AI Image Generation Time</span>
                    <span class="trend-value">@Model.AvgAiGenerationTimeSeconds Seconds</span>
                </div>
                <div class="trend-item">
                    <span class="trend-name">Rejected Offers Count</span>
                    <span class="trend-value">@Model.RejectedOffers</span>
                </div>
            </div>
        </div>

        <div class="card-panel">
            <h3 class="panel-title"><i class="ti ti-needle"></i> Popular Configurations</h3>
            <div class="trend-list">
                <div class="trend-item">
                    <div>
                        <div style="font-size: 10px; color: var(--muted); text-transform: uppercase;">Hair Style</div>
                        <span class="trend-name">@Model.MostPopularHairStyle</span>
                    </div>
                </div>
                <div class="trend-item">
                    <div>
                        <div style="font-size: 10px; color: var(--muted); text-transform: uppercase;">Outfit Theme</div>
                        <span class="trend-name">@Model.MostPopularOutfit</span>
                    </div>
                </div>
                <div class="trend-item">
                    <div>
                        <div style="font-size: 10px; color: var(--muted); text-transform: uppercase;">Accessory</div>
                        <span class="trend-name">@Model.MostPopularAccessories</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
