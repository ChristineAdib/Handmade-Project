@model HandoraApplication.IServices.PagedList<HandoraApplication.IServices.AdminProjectDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Custom Projects Workspaces";

    var search = ViewData["Search"] as string;
    var status = ViewData["Status"] as int?;
}

<style>
    :root {
        --br: #3d2010;
        --border: #e8e0d8;
        --text: #1b1c1c;
        --muted: #888;
        --green: #3b6d11;
        --green-bg: #eaf3de;
        --lt: #c4956a;
    }

    .projects-container {
        animation: fadeUp 0.4s ease both;
    }

    /* Progress bar wrapper */
    .progress-bar-wrap {
        width: 100px;
        background: #f0ebe4;
        border-radius: 4px;
        height: 8px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
        margin-right: 6px;
    }

    .progress-bar-fill {
        background: var(--green);
        height: 100%;
    }
</style>

<div class="projects-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 20px; font-weight: 600; color: var(--br);">Active Project Workspaces</h2>
        <a asp-action="ExportProjects" class="ptab"><i class="ti ti-download"></i> Export Projects</a>
    </div>

    <!-- Filters -->
    <form method="get" class="filter-bar" style="background:#fff; padding:16px; border-radius:12px; border:0.5px solid var(--border); display:flex; gap:12px; margin-bottom:20px;">
        <input type="text" name="search" value="@search" placeholder="Search Buyer, Seller..." class="filter-input" style="flex:1;" />
        <select name="status" class="filter-input">
            <option value="">-- All Workspace Statuses --</option>
            <option value="1" selected="@(status == 1)">Initiated</option>
            <option value="2" selected="@(status == 2)">Deposit Paid</option>
            <option value="3" selected="@(status == 3)">Sourcing Materials</option>
            <option value="4" selected="@(status == 4)">In Progress</option>
            <option value="5" selected="@(status == 5)">Quality Check</option>
            <option value="6" selected="@(status == 6)">Shipped</option>
            <option value="7" selected="@(status == 7)">Completed</option>
            <option value="8" selected="@(status == 8)">Refunded / Disputed</option>
        </select>
        <button type="submit" class="btn-search">Filter Workspaces</button>
        <a asp-action="Projects" class="ptab" style="text-decoration:none;">Clear</a>
    </form>

    <!-- Table -->
    <div class="an-card" style="padding:0; overflow:hidden;">
        <table class="an-table">
            <thead>
                <tr>
                    <th>Project Reference</th>
                    <th>Buyer</th>
                    <th>Seller / Artisan</th>
                    <th>Payment Status</th>
                    <th>Milestone Stage</th>
                    <th>Completion Ratio</th>
                    <th>Estimated Delivery</th>
                    <th class="r">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center; padding: 24px; color: var(--muted);">No active project workspaces found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var w in Model.Items)
                    {
                        <tr>
                            <td style="font-family: monospace; font-size:12px; font-weight:600; color: var(--md);">
                                @w.WorkspaceId.ToString().Substring(0, 8)...
                            </td>
                            <td>@w.BuyerName</td>
                            <td>@w.SellerName</td>
                            <td>
                                @if (w.PaymentStatus == "Paid")
                                {
                                    <span style="color: var(--green); font-weight:600;">Paid (Deposit)</span>
                                }
                                else
                                {
                                    <span>@w.PaymentStatus</span>
                                }
                            </td>
                            <td>
                                <div><strong>@w.MilestoneName</strong></div>
                                <span style="font-size:10px; color: var(--muted);">Step @w.MilestoneStep of 7</span>
                            </td>
                            <td>
                                <div class="progress-bar-wrap">
                                    <div class="progress-bar-fill" style="width: @w.CompletionPercentage%"></div>
                                </div>
                                <span style="font-size:11px; font-weight:600; color: var(--text);">@Math.Round(w.CompletionPercentage)%</span>
                            </td>
                            <td>@(w.EstimatedDeliveryDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                            <td class="r">
                                <a href="/AdminCustomStudio/Details/@w.RequestId" class="btn-page">Details</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination">
        <span>Showing Page @Model.PageNumber of @Model.TotalPages (Total @Model.TotalCount Projects)</span>
        <div style="display: flex; gap: 8px;">
            <a href="@Url.Action("Projects", new { search, status, pageNumber = Model.PageNumber - 1 })" 
               class="btn-page @(Model.HasPreviousPage ? "" : "disabled")">Previous</a>
            <a href="@Url.Action("Projects", new { search, status, pageNumber = Model.PageNumber + 1 })" 
               class="btn-page @(Model.HasNextPage ? "" : "disabled")">Next</a>
        </div>
    </div>
</div>
