@model HandoraDomain.Models.CustomStudioEntities.CustomRequest
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Request Details";
}

<style>
    :root {
        --br: #3d2010;
        --md: #7a5433;
        --lt: #c4956a;
        --border: #e8e0d8;
        --text: #1b1c1c;
        --muted: #888;
        --green: #3b6d11;
        --red: #a32d2d;
    }

    .details-container {
        animation: fadeUp 0.4s ease both;
    }

    .section-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .full-width {
        grid-column: span 2;
    }

    .meta-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .meta-row {
        display: flex;
        justify-content: space-between;
        padding-bottom: 8px;
        border-bottom: 0.5px solid #f0ebe4;
        font-size: 13px;
    }

    .meta-label {
        color: var(--muted);
        font-weight: 500;
    }

    .meta-val {
        font-weight: 600;
        color: var(--text);
    }

    .design-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        margin-top: 12px;
    }

    .design-card {
        border: 0.5px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
        background: #faf8f5;
        text-align: center;
        padding: 8px;
        position: relative;
    }

    .design-card img {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 6px;
        margin-bottom: 8px;
    }

    .badge-selected {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--green);
        color: #fff;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .timeline {
        position: relative;
        padding-left: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        top: 4px;
        left: 7px;
        width: 2px;
        height: 100%;
        background-color: var(--border);
    }

    .timeline-node {
        position: relative;
    }

    .timeline-node::before {
        content: '';
        position: absolute;
        top: 4px;
        left: -21px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--lt);
        border: 2px solid #fff;
    }

    .timeline-node.active::before {
        background-color: var(--green);
    }

    .request-details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .section-grid {
            grid-template-columns: 1fr;
        }
        .full-width {
            grid-column: span 1;
        }
    }

    @@media (max-width: 480px) {
        .request-details-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
        .request-details-header div {
            width: 100%;
        }
        .request-details-header button {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="details-container">
    <!-- Header -->
    <div class="request-details-header">
        <div>
            <a asp-action="Requests" style="font-size: 12px; color: var(--lt); text-decoration: none;"><i class="ti ti-arrow-left"></i> Back to Requests</a>
            <h2 style="font-size: 20px; font-weight: 600; color: var(--br); margin-top: 4px;">Custom Request Details</h2>
            <span style="font-size: 11px; color: var(--muted); font-family: monospace;">ID: @Model.Id</span>
        </div>
        <div style="display: flex; gap: 8px;">
            @if (Model.Status != HandoraDomain.Consts.CustomRequestStatus.Cancelled)
            {
                <button type="button" class="ptab" style="color: var(--red); border-color: var(--red);" onclick="document.getElementById('cancelModal').style.display='flex'">Cancel Request</button>
            }
        </div>
    </div>

    <!-- Alert Success/Error -->
    @if (TempData["Success"] != null)
    {
        <div style="background: var(--green-bg); color: var(--green); padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size:13px; font-weight:600;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: var(--red-bg); color: var(--red); padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size:13px; font-weight:600;">
            @TempData["Error"]
        </div>
    }

    <!-- Main Grid -->
    <div class="section-grid">
        <!-- 1. Metadata Panel -->
        <div class="an-card">
            <h3 class="panel-title"><i class="ti ti-info-circle"></i> General Information</h3>
            <div class="meta-list">
                <div class="meta-row">
                    <span class="meta-label">Buyer / Customer</span>
                    <span class="meta-val">@Model.Buyer.Name (@Model.Buyer.Email)</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Status</span>
                    <span class="meta-val">@Model.Status.ToString()</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Target Budget</span>
                    <span class="meta-val">@(Model.TargetBudget?.ToString("C") ?? "Open Budget")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Target Deadline</span>
                    <span class="meta-val">@(Model.DeadlineDate?.ToString("yyyy-MM-dd") ?? "Flexible")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Created Date</span>
                    <span class="meta-val">@Model.CreatedAt.ToString("g")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">AI Generation Count</span>
                    <span class="meta-val">@Model.GenerationCount / 2</span>
                </div>
            </div>
        </div>

        <!-- 2. Configuration Panel -->
        <div class="an-card">
            <h3 class="panel-title"><i class="ti ti-needle"></i> Custom Amigurumi Configuration</h3>
            @if (Model.CustomConfiguration != null)
            {
                <div class="meta-list" style="max-height: 250px; overflow-y: auto;">
                    @{
                        string size = "Standard";
                        string body = "Default";
                        string skin = "N/A";
                        string hair = "N/A";
                        string smile = "N/A";
                        string outfit = "N/A";
                        string notes = "N/A";
                        try
                        {
                            using var doc = JsonDocument.Parse(Model.CustomConfiguration.ConfigurationDataJson);
                            var root = doc.RootElement;
                            if (root.TryGetProperty("size", out var s)) size = s.ToString();
                            if (root.TryGetProperty("bodyType", out var b)) body = b.ToString();
                            if (root.TryGetProperty("skinTone", out var sk)) skin = sk.ToString();
                            if (root.TryGetProperty("hair", out var h) && h.TryGetProperty("style", out var hst) && h.TryGetProperty("color", out var hc)) hair = $"{hst} ({hc})";
                            if (root.TryGetProperty("face", out var f) && f.TryGetProperty("smile", out var sm)) smile = sm.ToString();
                            if (root.TryGetProperty("outfit", out var o) && o.TryGetProperty("type", out var ot)) outfit = ot.ToString();
                            if (root.TryGetProperty("additionalNotes", out var n)) notes = n.ToString();
                        }
                        catch {}
                    }
                    <div class="meta-row"><span class="meta-label">Doll Size</span><span class="meta-val">@size</span></div>
                    <div class="meta-row"><span class="meta-label">Body Shape</span><span class="meta-val">@body</span></div>
                    <div class="meta-row"><span class="meta-label">Skin Tone</span><span class="meta-val">@skin</span></div>
                    <div class="meta-row"><span class="meta-label">Hair Configuration</span><span class="meta-val">@hair</span></div>
                    <div class="meta-row"><span class="meta-label">Smile Style</span><span class="meta-val">@smile</span></div>
                    <div class="meta-row"><span class="meta-label">Outfit Type</span><span class="meta-val">@outfit</span></div>
                    <div class="meta-row"><span class="meta-label">Artisan Instructions</span><span class="meta-val">@notes</span></div>
                </div>
            }
            else
            {
                <p style="font-size:13px; color: var(--muted);">No amigurumi customizations configured yet.</p>
            }
        </div>

        <!-- 3. AI Generated Designs (Full Width) -->
        <div class="an-card full-width">
            <h3 class="panel-title"><i class="ti ti-cpu"></i> AI Generated Designs & blueprints</h3>
            <div class="design-grid">
                @foreach (var design in Model.GeneratedDesigns)
                {
                    <div class="design-card">
                        @if (design.Id == Model.SelectedDesignId)
                        {
                            <span class="badge-selected">SELECTED</span>
                        }
                        <img src="@design.ImageUrl" alt="AI Generated Design" />
                        <div style="font-size:11px; font-weight:600; color: var(--md); margin-bottom:4px;">Score: @Math.Round(design.MatchingScore * 100)%</div>
                        <div style="font-size:10px; color: var(--muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="@design.Prompt">Prompt: @design.Prompt</div>
                    </div>
                }
            </div>
        </div>

        <!-- 4. Negotiation & Offers -->
        <div class="an-card">
            <h3 class="panel-title"><i class="ti ti-coin"></i> Seller Bid Offers</h3>
            @if (!Model.CustomOffers.Any())
            {
                <p style="font-size: 13px; color: var(--muted);">No bids submitted by sellers yet.</p>
            }
            else
            {
                <div class="meta-list">
                    @foreach (var offer in Model.CustomOffers)
                    {
                        <div class="trend-item" style="margin-bottom:8px;">
                            <div>
                                <strong>@offer.Shop.Name</strong>
                                <div style="font-size:11px; color: var(--muted);">Price: @offer.Price.ToString("C") | Delivery: @offer.DeliveryTimeDays Days</div>
                            </div>
                            <span class="badge" style="background: #faf0e6; color: var(--br);">@offer.Status.ToString()</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 5. Collaborative Timeline (Workspace) -->
        <div class="an-card">
            <h3 class="panel-title"><i class="ti ti-hammer"></i> Artisan Project Workspace</h3>
            @if (Model.ProjectWorkspace == null)
            {
                <p style="font-size: 13px; color: var(--muted);">Workspace timeline will initialize once payment deposit is settled.</p>
            }
            else
            {
                <div class="meta-list" style="margin-bottom: 16px;">
                    <div class="meta-row">
                        <span class="meta-label">Current Milestone</span>
                        <span class="meta-val">Step @Model.ProjectWorkspace.MilestoneStep / 7</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Payment Status</span>
                        <span class="meta-val">@Model.ProjectWorkspace.PaymentStatus.ToString()</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ProjectWorkspace.TrackingNumber))
                    {
                        <div class="meta-row">
                            <span class="meta-label">Shipping Tracking</span>
                            <span class="meta-val" style="color: var(--lt);">@Model.ProjectWorkspace.TrackingNumber</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.ProjectWorkspace.FinalPhotoUrl))
                {
                    <div style="border-radius: 8px; overflow:hidden; text-align:center;">
                        <img src="@Model.ProjectWorkspace.FinalPhotoUrl" alt="Final Progress Upload" style="max-height: 180px; object-fit: contain;" />
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Cancel Request Modal -->
<div id="cancelModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:2000; align-items:center; justify-content:center;">
    <div style="background:#fff; width:400px; padding:24px; border-radius:12px; box-shadow:0 12px 30px rgba(0,0,0,0.15);">
        <h3 style="color: var(--br); margin-bottom:12px;">Cancel Custom Request</h3>
        <form asp-action="CancelRequest" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <textarea name="reason" placeholder="Write a cancellation reason notes..." style="width:100%; height:80px; padding:8px; border-radius:6px; border:0.5px solid var(--border); font-family:inherit; font-size:13px; margin-bottom:16px;" required></textarea>
            <div style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="ptab" onclick="document.getElementById('cancelModal').style.display='none'">Dismiss</button>
                <button type="submit" class="btn-search" style="background: var(--red);">Confirm Cancellation</button>
            </div>
        </form>
    </div>
</div>
