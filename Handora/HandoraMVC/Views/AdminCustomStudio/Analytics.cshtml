@model HandoraApplication.IServices.AdminCustomStudioDashboardDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Custom Studio Analytics Charts";
}

<style>
    :root {
        --br: #3d2010;
        --border: #e8e0d8;
    }

    .analytics-container {
        animation: fadeUp 0.4s ease both;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 20px;
    }

    .chart-card {
        background: #fff;
        border: 0.5px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        min-height: 340px;
    }

    .chart-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--br);
        margin-bottom: 16px;
    }
</style>

<div class="analytics-container">
    <h2 style="font-size: 20px; font-weight: 600; color: var(--br); margin-bottom: 20px;">Visual Analytics Dashboard</h2>

    <div class="charts-grid">
        <!-- Chart 1: Project Funnel / Custom Requests Distribution -->
        <div class="chart-card">
            <h3 class="chart-title"><i class="ti ti-chart-pie"></i> Custom Request Funnel Statuses</h3>
            <div style="height: 250px; display: flex; align-items: center; justify-content: center;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

        <!-- Chart 2: Bids Offer Statuses -->
        <div class="chart-card">
            <h3 class="chart-title"><i class="ti ti-chart-bar"></i> Offers Bids Breakdown</h3>
            <div style="height: 250px; display: flex; align-items: center; justify-content: center;">
                <canvas id="offersChart"></canvas>
            </div>
        </div>

        <!-- Chart 3: Amigurumi Popular Design Choices -->
        <div class="chart-card" style="grid-column: span 2;">
            <h3 class="chart-title"><i class="ti ti-adjustments"></i> Custom Design Choices Overview</h3>
            <div class="trend-list" style="display:flex; justify-content:space-around; align-items:center; gap:20px; padding: 20px 0;">
                <div style="text-align:center;">
                    <div style="font-size: 32px; font-weight: 700; color: var(--lt);">@Model.MostPopularHairStyle</div>
                    <div style="font-size: 12px; color: var(--muted); text-transform:uppercase; margin-top:4px;">Popular Hair Style</div>
                </div>
                <div style="text-align:center; border-left: 0.5px solid var(--border); padding-left: 40px; border-right: 0.5px solid var(--border); padding-right: 40px;">
                    <div style="font-size: 32px; font-weight: 700; color: var(--br);">@Model.MostPopularOutfit</div>
                    <div style="font-size: 12px; color: var(--muted); text-transform:uppercase; margin-top:4px;">Popular Outfit Style</div>
                </div>
                <div style="text-align:center;">
                    <div style="font-size: 32px; font-weight: 700; color: var(--green);">@Model.MostPopularAccessories</div>
                    <div style="font-size: 12px; color: var(--muted); text-transform:uppercase; margin-top:4px;">Popular Accessories</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Status Chart (Pie)
            var ctxStatus = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['Total Requests', 'Completed Projects', 'Cancelled Projects'],
                    datasets: [{
                        data: [@Model.TotalRequests, @Model.CompletedProjects, @Model.CancelledProjects],
                        backgroundColor: ['#c4956a', '#3b6d11', '#a32d2d'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, font: { size: 11 } }
                        }
                    }
                }
            });

            // Offers Chart (Bar)
            var ctxOffers = document.getElementById('offersChart').getContext('2d');
            new Chart(ctxOffers, {
                type: 'bar',
                data: {
                    labels: ['Pending', 'Accepted', 'Rejected'],
                    datasets: [{
                        label: 'Submitted Offers Count',
                        data: [@Model.PendingOffers, @Model.AcceptedOffers, @Model.RejectedOffers],
                        backgroundColor: ['#c4956a', '#3b6d11', '#a32d2d'],
                        borderWidth: 0,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, grid: { display: false } },
                        x: { grid: { display: false } }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}
