@model HandoraMVC.ViewModels.SellerIndexViewModel

@{
    ViewData["Title"] = "Sellers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h2>Sellers</h2>
    <span style="font-size:13px;color:#888">@Model.Sellers.Count total</span>
</div>

<div class="table-card">
    <table>
        <colgroup>
            <col style="width:60px" />
            <col />
            <col />
            <col style="width:100px" />
            <col style="width:120px" />
            <col style="width:100px" />
            <col style="width:180px" />
        </colgroup>
        <thead>
            <tr>
                <th>Photo</th>
                <th>Name</th>
                <th>Shop</th>
                <th>Rating</th>
                <th>Member Since</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var seller in Model.Sellers)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(seller.ProfileImage))
                        {
                            <img src="@seller.ProfileImage" alt="@seller.Name" class="cat-img" style="border-radius:50%" />
                        }
                        else
                        {
                            <div class="cat-img-placeholder" style="border-radius:50%;background:#f5ede4">
                                <i class="ti ti-user" style="font-size:16px;color:#c4956a" aria-hidden="true"></i>
                            </div>
                        }
                    </td>
                    <td>
                        <div style="font-weight:500">@seller.Name</div>
                        @if (!string.IsNullOrEmpty(seller.Bio))
                        {
                            <div style="font-size:12px;color:#888;margin-top:2px">
                                @(seller.Bio.Length > 40 ? seller.Bio[..40] + "..." : seller.Bio)
                            </div>
                        }
                    </td>
                    <td>
                        @if (seller.ShopId != Guid.Empty)
                        {
                            <a asp-action="Shop" asp-route-id="@seller.ShopId"
                               style="color:#7a5433;text-decoration:none;font-weight:500">
                                <i class="ti ti-store" style="font-size:14px" aria-hidden="true"></i>
                                @seller.ShopName
                            </a>
                        }
                        else
                        {
                            <span style="color:#bbb;font-size:12px">No shop</span>
                        }
                    </td>
                    <td>
                        <div style="display:flex;align-items:center;gap:4px">
                            <i class="ti ti-star-filled" style="font-size:13px;color:#c4956a" aria-hidden="true"></i>
                            <span>@seller.Rating.ToString("F1")</span>
                            <span style="color:#bbb;font-size:11px">(@seller.ReviewCount)</span>
                        </div>
                    </td>
                    <td style="font-size:12px;color:#888">
                        @seller.MemberSince.ToString("MMM yyyy")
                    </td>
                    <td>
                        @if (seller.IsSuspended)
                        {
                            <span class="badge badge-cancelled">Suspended</span>
                        }
                        else if (seller.IsVerified)
                        {
                            <span class="badge badge-complete">Approved</span>
                        }
                        else
                        {
                            <span class="badge badge-pending">Pending</span>
                        }
                    </td>
                    <td>
                        <div style="display:flex;gap:6px">
                            @if (!seller.IsVerified && !seller.IsSuspended)
                            {
                                <button onclick="submitAction('/Sellers/Approve/@seller.Id')" class="btn-edit">
                                    <i class="ti ti-check" aria-hidden="true"></i> Approve
                                </button>
                            }
                            @if (!seller.IsSuspended)
                            {
                                <button onclick="submitAction('/Sellers/Suspend/@seller.Id')" class="btn-delete">
                                    <i class="ti ti-ban" aria-hidden="true"></i> Suspend
                                </button>
                            }
                            @if (seller.IsSuspended)
                            {
                                <button onclick="submitAction('/Sellers/Unsuspend/@seller.Id')" class="btn-edit">
                                    <i class="ti ti-refresh" aria-hidden="true"></i> Unsuspend
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<form id="action-form" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

<script>
    function submitAction(url) {
        const form = document.getElementById('action-form');
        form.action = url;
        form.submit();
    }
</script>