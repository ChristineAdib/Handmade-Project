@model HandoraApplication.DTOs.AdminDashboardDTOs.AdminDashboardDto
@using HandoraApplication.DTOs.AdminDashboardDTOs

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Analytics";
    var period = (RevenueChartPeriod)ViewData["SelectedPeriod"]!;
}

<style>
/* ── Tokens (نفس ألوان admin.css) ────────────────────────── */
:root {
    --br:   #3d2010;   /* sidebar dark brown   */
    --md:   #7a5433;   /* medium brown         */
    --lt:   #c4956a;   /* light gold           */
    --cream:#f5e6d3;   /* cream                */
    --bg:   #f5f0eb;   /* page background      */
    --card: #ffffff;
    --border: #e8e0d8;
    --text:   #1b1c1c;
    --muted:  #888;
    --green:  #3b6d11;
    --green-bg: #eaf3de;
    --red:    #a32d2d;
    --red-bg: #fcebeb;
}

/* ── Animations ──────────────────────────────────────────── */
@@keyframes fadeUp {
    from { opacity:0; transform:translateY(14px); }
    to   { opacity:1; transform:translateY(0); }
}
@@keyframes countUp {
    from { opacity:0; transform:scale(.85); }
    to   { opacity:1; transform:scale(1); }
}

.fade-up {
    opacity:0;
    animation: fadeUp .45s ease forwards;
}
.fade-up:nth-child(1) { animation-delay:.05s; }
.fade-up:nth-child(2) { animation-delay:.12s; }
.fade-up:nth-child(3) { animation-delay:.19s; }

/* ── Grid helpers ────────────────────────────────────────── */
.an-grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:14px; }
.an-grid-2 { display:grid; grid-template-columns:1fr 1fr;       gap:12px; margin-bottom:14px; }

/* ── Section card (بنفس border/radius الـ admin.css) ─────── */
.an-card {
    background: var(--card);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    transition: box-shadow .2s, transform .2s;
}
.an-card:hover {
    box-shadow: 0 4px 16px rgba(61,32,16,.08);
    transform: translateY(-1px);
}

/* ── KPI sales cards ─────────────────────────────────────── */
.kpi-inner {
    display: flex;
    align-items: center;
    gap: 12px;
}
.kpi-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    transition: transform .2s;
}
.an-card:hover .kpi-icon-wrap { transform: rotate(-6deg) scale(1.1); }

.kpi-icon-wrap.warm  { background:#faeeda; color:#854f0b; }
.kpi-icon-wrap.sage  { background:var(--green-bg); color:var(--green); }
.kpi-icon-wrap.clay  { background:#fdf0e8; color:var(--lt); }

.kpi-lbl {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: 3px;
}
.kpi-val {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    animation: countUp .5s ease both;
}

/* ── Count cards ─────────────────────────────────────────── */
.cnt-header {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
    color: var(--md);
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: 12px;
}
.cnt-header i { font-size: 15px; color: var(--lt); }
.cnt-cells { display:flex; gap:0; }
.cnt-cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 4px;
    position: relative;
}
.cnt-cell + .cnt-cell::before {
    content: '';
    position: absolute;
    left: 0; top: 4px; bottom: 4px;
    width: 0.5px;
    background: var(--border);
}
.cnt-num {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    animation: countUp .6s ease both;
}
.cnt-num.dim { color: #c4b5a8; }
.cnt-lbl { font-size: 10px; color: var(--muted); text-transform:uppercase; margin-top:3px; }

/* ── Section header ──────────────────────────────────────── */
.an-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}
.an-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 7px;
}
.an-title i { color: var(--lt); font-size: 16px; }

/* ── Period tabs ─────────────────────────────────────────── */
.ptabs { display:flex; gap:4px; }
.ptab {
    padding: 4px 12px;
    border-radius: 6px;
    border: 0.5px solid var(--border);
    font-size: 12px;
    cursor: pointer;
    background: #fff;
    color: var(--md);
    transition: all .15s;
    font-family: inherit;
}
.ptab:hover { background: #faf7f4; }
.ptab.active {
    background: var(--br);
    color: var(--cream);
    border-color: var(--br);
}

/* ── Chart wrapper ───────────────────────────────────────── */
.chart-wrap { position:relative; }

/* ── Data tables ─────────────────────────────────────────── */
.an-table { width:100%; border-collapse:collapse; font-size:13px; }
.an-table thead th {
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    padding: 7px 10px;
    text-align: left;
    border-bottom: 0.5px solid var(--border);
    background: #faf7f4;
}
.an-table thead th.r { text-align:right; }
.an-table tbody td {
    padding: 10px 10px;
    border-bottom: 0.5px solid #f0ebe4;
    color: var(--text);
    vertical-align: middle;
}
.an-table tbody tr:last-child td { border-bottom:none; }
.an-table tbody tr { transition: background .12s; }
.an-table tbody tr:hover td { background:#faf7f4; }
.r { text-align:right; }

/* ── Rank pill ───────────────────────────────────────────── */
.rpill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: #faeeda;
    color: #854f0b;
    font-size: 11px;
    font-weight: 700;
}
.rpill.r1 { background:var(--br); color:var(--cream); }
.rpill.r2 { background:var(--md); color:#fff; }
.rpill.r3 { background:var(--lt); color:#fff; }

/* ── Thumb / avatar ──────────────────────────────────────── */
.an-thumb { width:34px; height:34px; border-radius:6px; object-fit:cover; flex-shrink:0; }
.an-avatar { width:30px; height:30px; border-radius:50%; object-fit:cover; flex-shrink:0; }
.an-letter {
    width:30px; height:30px; border-radius:50%;
    background:var(--br); color:var(--cream);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:12px; flex-shrink:0;
}
.cell-duo { display:flex; align-items:center; gap:9px; }
.cell-sub { font-size:11px; color:var(--muted); }

/* ── Revenue bar ─────────────────────────────────────────── */
.rev-bar-wrap { display:flex; align-items:center; gap:8px; }
.rev-bar-bg   { flex:1; height:5px; border-radius:3px; background:#f0ebe4; overflow:hidden; }
.rev-bar-fill { height:100%; background:var(--lt); border-radius:3px; transition:width .6s ease; }

/* ── Coupon section ──────────────────────────────────────── */
.coupon-kpis { display:flex; gap:0; margin-bottom:14px; }
.ckpi {
    flex:1;
    display:flex; flex-direction:column; align-items:center;
    padding:10px 4px;
    position:relative;
}
.ckpi + .ckpi::before {
    content:''; position:absolute; left:0; top:10px; bottom:10px;
    width:0.5px; background:var(--border);
}
.ckpi-num { font-size:1.5rem; font-weight:700; color:var(--br); line-height:1; animation:countUp .6s ease both; }
.ckpi-lbl { font-size:10px; color:var(--muted); text-transform:uppercase; margin-top:3px; }

.coupon-rows { list-style:none; padding:0; margin:0; }
.coupon-row {
    display:flex; justify-content:space-between; align-items:center;
    padding:8px 0;
    border-bottom:0.5px solid #f0ebe4;
    font-size:12px;
    animation: fadeUp .4s ease both;
}
.coupon-row:last-child { border-bottom:none; }
.c-code {
    background:#faeeda; color:#854f0b;
    padding:2px 8px; border-radius:20px;
    font-size:11px; font-weight:600;
    margin-right:6px;
}
.c-expired {
    background:var(--red-bg); color:var(--red);
    padding:2px 7px; border-radius:20px; font-size:10px;
}
.c-badge {
    background:var(--green-bg); color:var(--green);
    padding:2px 8px; border-radius:20px; font-size:11px;
}
.c-muted { color:var(--muted); }

/* ── Text helpers ────────────────────────────────────────── */
.t-green { color:var(--green); font-weight:600; }
.t-red   { color:var(--red);   font-size:11px; }
.t-muted { color:var(--muted); }
.t-sm    { font-size:11px; }
.fw6     { font-weight:600; }

    @@media (max-width: 768px) {
        .an-grid-3 {
            grid-template-columns: 1fr;
        }
        .an-grid-2 {
            grid-template-columns: 1fr;
        }
        .an-card {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .an-card table {
            min-width: 600px;
        }
    }
    @@media (max-width: 480px) {
        .an-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
        .ptabs {
            width: 100%;
        }
        .ptab {
            flex: 1;
            text-align: center;
        }
    }
</style>

<!-- ══════════════════════════════════════════
     ROW 1 – Sales KPI
══════════════════════════════════════════ -->
<div class="an-grid-3">

    <div class="an-card fade-up">
        <div class="kpi-inner">
            <div class="kpi-icon-wrap warm">
                <i class="ti ti-calendar-stats"></i>
            </div>
            <div>
                <div class="kpi-lbl">Today's Sales</div>
                <div class="kpi-val">EGP @Model.SalesSummary.TodaySales.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="an-card fade-up">
        <div class="kpi-inner">
            <div class="kpi-icon-wrap sage">
                <i class="ti ti-calendar-week"></i>
            </div>
            <div>
                <div class="kpi-lbl">This Week</div>
                <div class="kpi-val">EGP @Model.SalesSummary.WeekSales.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="an-card fade-up">
        <div class="kpi-inner">
            <div class="kpi-icon-wrap clay">
                <i class="ti ti-calendar-month"></i>
            </div>
            <div>
                <div class="kpi-lbl">This Month</div>
                <div class="kpi-val">EGP @Model.SalesSummary.MonthSales.ToString("N2")</div>
            </div>
        </div>
    </div>

</div>

<!-- ══════════════════════════════════════════
     ROW 2 – Counts
══════════════════════════════════════════ -->
<div class="an-grid-3">

    <div class="an-card fade-up">
        <div class="cnt-header">
            <i class="ti ti-shopping-bag"></i> New Orders
        </div>
        <div class="cnt-cells">
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewOrdersToday</span>
                <span class="cnt-lbl">Today</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewOrdersThisWeek</span>
                <span class="cnt-lbl">Week</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewOrdersThisMonth</span>
                <span class="cnt-lbl">Month</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num dim">@Model.Counts.TotalOrders</span>
                <span class="cnt-lbl">Total</span>
            </div>
        </div>
    </div>

    <div class="an-card fade-up">
        <div class="cnt-header">
            <i class="ti ti-users"></i> New Buyers
        </div>
        <div class="cnt-cells">
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewUsersToday</span>
                <span class="cnt-lbl">Today</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewUsersThisWeek</span>
                <span class="cnt-lbl">Week</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewUsersThisMonth</span>
                <span class="cnt-lbl">Month</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num dim">@Model.Counts.TotalUsers</span>
                <span class="cnt-lbl">Total</span>
            </div>
        </div>
    </div>

    <div class="an-card fade-up">
        <div class="cnt-header">
            <i class="ti ti-store"></i> New Sellers
        </div>
        <div class="cnt-cells">
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewSellersToday</span>
                <span class="cnt-lbl">Today</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewSellersThisWeek</span>
                <span class="cnt-lbl">Week</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num">@Model.Counts.NewSellersThisMonth</span>
                <span class="cnt-lbl">Month</span>
            </div>
            <div class="cnt-cell">
                <span class="cnt-num dim">@Model.Counts.TotalSellers</span>
                <span class="cnt-lbl">Total</span>
            </div>
        </div>
    </div>

</div>

<!-- ══════════════════════════════════════════
     ROW 3 – Charts Row
══════════════════════════════════════════ -->
<div class="charts-row">

    <!-- Bar chart (60%) -->
    <div class="an-card fade-up charts-main">
        <div class="an-header">
            <span class="an-title">
                <i class="ti ti-chart-bar"></i> Revenue Over Time
            </span>
            <div class="ptabs" id="periodBtns">
                <button class="ptab @(period == RevenueChartPeriod.Daily   ? "active" : "")" data-period="1">Daily</button>
                <button class="ptab @(period == RevenueChartPeriod.Weekly  ? "active" : "")" data-period="2">Weekly</button>
                <button class="ptab @(period == RevenueChartPeriod.Monthly ? "active" : "")" data-period="3">Monthly</button>
            </div>
        </div>
        <canvas id="revenueChart" height="110"></canvas>
    </div>

    <!-- Donut (40%) -->
    <div class="an-card fade-up charts-side">
        <div class="an-header">
            <span class="an-title">
                <i class="ti ti-chart-donut"></i> Sales Breakdown
            </span>
        </div>

        <!-- donut canvas -->
        <div style="position:relative; width:170px; margin:0 auto 16px;">
            <canvas id="donutChart" width="170" height="170"></canvas>
            <div class="donut-center">
                <div class="donut-total" id="donutTotal">
                    EGP @((Model.SalesSummary.TodaySales + Model.SalesSummary.WeekSales + Model.SalesSummary.MonthSales).ToString("N0"))
                </div>
                <div class="donut-sub">Total</div>
            </div>
        </div>

        <!-- legend -->
        <div class="donut-legend">
            <div class="dl-item">
                <span class="dl-dot" style="background:#3d2010"></span>
                <span class="dl-lbl">Today</span>
                <span class="dl-val">EGP @Model.SalesSummary.TodaySales.ToString("N0")</span>
            </div>
            <div class="dl-item">
                <span class="dl-dot" style="background:#c4956a"></span>
                <span class="dl-lbl">This Week</span>
                <span class="dl-val">EGP @Model.SalesSummary.WeekSales.ToString("N0")</span>
            </div>
            <div class="dl-item">
                <span class="dl-dot" style="background:#f5e6d3; border:1px solid #c4956a;"></span>
                <span class="dl-lbl">This Month</span>
                <span class="dl-val">EGP @Model.SalesSummary.MonthSales.ToString("N0")</span>
            </div>
        </div>
    </div>

</div>

<style>
.charts-row  { display:grid; grid-template-columns:3fr 2fr; gap:12px; margin-bottom:14px; }
.charts-main { min-width:0; }
.charts-side { display:flex; flex-direction:column; }

/* donut center label */
.donut-center {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
}
.donut-total { font-size:.78rem; font-weight:700; color:#3d2010; line-height:1.2; }
.donut-sub   { font-size:.65rem; color:#888; text-transform:uppercase; }

/* legend */
.donut-legend { display:flex; flex-direction:column; gap:8px; margin-top:auto; }
.dl-item { display:flex; align-items:center; gap:8px; font-size:12px; }
.dl-dot  { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.dl-lbl  { color:#888; flex:1; }
.dl-val  { font-weight:600; color:#1b1c1c; }
</style>

<!-- ══════════════════════════════════════════
     ROW 4 – Top Products + Coupon Stats
══════════════════════════════════════════ -->
<div class="an-grid-2">

    <!-- Top 5 Products -->
    <div class="an-card fade-up">
        <div class="an-header">
            <span class="an-title"><i class="ti ti-package"></i> Top 5 Products</span>
        </div>
        @{
            var maxRev = Model.TopProducts.Any() ? Model.TopProducts.Max(p => p.TotalRevenue) : 1m;
            int prank  = 1;
        }
        <table class="an-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th class="r">Qty</th>
                    <th class="r">Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.TopProducts)
                {
                    var pct = maxRev > 0 ? (int)((p.TotalRevenue / maxRev) * 100) : 0;
                    <tr>
                        <td><span class="rpill @(prank==1?"r1":prank==2?"r2":prank==3?"r3":"")">@prank</span></td>
                        <td>
                            <div class="cell-duo">
                                @if (!string.IsNullOrEmpty(p.PictureUrl))
                                {
                                    <img src="@p.PictureUrl" class="an-thumb" alt="@p.ProductName" />
                                }
                                <div>
                                    <div class="fw6">@p.ProductName</div>
                                    <div class="cell-sub">@p.ShopName</div>
                                </div>
                            </div>
                        </td>
                        <td class="r t-muted">@p.QuantitySold</td>
                        <td class="r">
                            <div class="t-green">EGP @p.TotalRevenue.ToString("N0")</div>
                            <div class="rev-bar-wrap" style="margin-top:4px;">
                                <div class="rev-bar-bg">
                                    <div class="rev-bar-fill" style="width:@pct%"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    prank++;
                }
            </tbody>
        </table>
    </div>

    <!-- Coupon Stats -->
    <div class="an-card fade-up">
        <div class="an-header">
            <span class="an-title"><i class="ti ti-ticket"></i> Coupon Overview</span>
        </div>

        <div class="coupon-kpis">
            <div class="ckpi">
                <span class="ckpi-num">@Model.CouponStats.ActiveCouponsCount</span>
                <span class="ckpi-lbl">Active</span>
            </div>
            <div class="ckpi">
                <span class="ckpi-num">@Model.CouponStats.TotalCouponsUsedCount</span>
                <span class="ckpi-lbl">Redeemed</span>
            </div>
            <div class="ckpi">
                <span class="ckpi-num">@Model.CouponStats.TotalDiscountGiven.ToString("N0")</span>
                <span class="ckpi-lbl">EGP Saved</span>
            </div>
        </div>

        <div style="font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">
            Top Coupons by Usage
        </div>
        <ul class="coupon-rows">
            @foreach (var c in Model.CouponStats.TopCoupons)
            {
                <li class="coupon-row">
                    <div>
                        <span class="c-code">@c.Code</span>
                        @if (!c.IsActive || c.ExpiryDate < DateTime.UtcNow)
                        {
                            <span class="c-expired">Expired</span>
                        }
                    </div>
                    <span class="c-muted">@c.UsageCount uses &nbsp;·&nbsp; EGP @c.TotalDiscountGiven.ToString("N0")</span>
                </li>
            }
        </ul>
    </div>

</div>

<!-- ══════════════════════════════════════════
     ROW 5 – Top Sellers + Top Buyers
══════════════════════════════════════════ -->
<div class="an-grid-2">

    <!-- Top Sellers -->
    <div class="an-card fade-up">
        <div class="an-header">
            <span class="an-title"><i class="ti ti-store"></i> Most Active Sellers</span>
        </div>
        @{ int srank = 1; var maxSRev = Model.TopSellers.Any() ? Model.TopSellers.Max(s => s.TotalRevenue) : 1m; }
        <table class="an-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Shop</th>
                    <th class="r">Orders</th>
                    <th class="r">Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.TopSellers)
                {
                    var spct = maxSRev > 0 ? (int)((s.TotalRevenue / maxSRev) * 100) : 0;
                    <tr>
                        <td><span class="rpill @(srank==1?"r1":srank==2?"r2":srank==3?"r3":"")">@srank</span></td>
                        <td>
                            <div class="cell-duo">
                                @if (!string.IsNullOrEmpty(s.Logo))
                                {
                                    <img src="@s.Logo" class="an-avatar" alt="@s.ShopName" />
                                }
                                else
                                {
                                    <div class="an-letter">@s.ShopName.FirstOrDefault()</div>
                                }
                                <div>
                                    <div class="fw6">@s.ShopName</div>
                                    <div class="cell-sub">@s.SellerName &nbsp;·&nbsp; @s.Rating.ToString("F1") ⭐</div>
                                </div>
                            </div>
                        </td>
                        <td class="r t-muted">@s.OrdersCount</td>
                        <td class="r">
                            <div class="t-green">EGP @s.TotalRevenue.ToString("N0")</div>
                            <div class="rev-bar-wrap" style="margin-top:4px;">
                                <div class="rev-bar-bg">
                                    <div class="rev-bar-fill" style="width:@spct%"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    srank++;
                }
            </tbody>
        </table>
    </div>

    <!-- Top Buyers -->
    <div class="an-card fade-up">
        <div class="an-header">
            <span class="an-title"><i class="ti ti-users"></i> Most Active Buyers</span>
        </div>
        @{ int brank = 1; }
        <table class="an-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Buyer</th>
                    <th class="r">Orders</th>
                    <th class="r">Spent</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.TopBuyers)
                {
                    <tr>
                        <td><span class="rpill @(brank==1?"r1":brank==2?"r2":brank==3?"r3":"")">@brank</span></td>
                        <td>
                            <div class="fw6">@b.BuyerName</div>
                            <div class="cell-sub">@b.Email</div>
                            @if (b.CouponsUsedCount > 0)
                            {
                                <span class="c-badge" style="margin-top:3px;display:inline-block;">@b.CouponsUsedCount 🎟 coupons</span>
                            }
                        </td>
                        <td class="r t-muted">@b.OrdersCount</td>
                        <td class="r">
                            <div class="t-green">EGP @b.TotalSpent.ToString("N0")</div>
                            @if (b.TotalDiscountReceived > 0)
                            {
                                <div class="t-red">–EGP @b.TotalDiscountReceived.ToString("N0") saved</div>
                            }
                        </td>
                    </tr>
                    brank++;
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
<script>
    const BR   = '#3d2010';
    const LT   = '#c4956a';
    const BLUE = '#185fa5';

    // ── 1. Bar + Line chart ───────────────────────────────────
    const initialData = {
        labels:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Points.Select(p => p.Label))),
        revenues: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Points.Select(p => p.Revenue))),
        orders:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Points.Select(p => p.OrdersCount)))
    };

    const ctx  = document.getElementById('revenueChart').getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 280);
    grad.addColorStop(0, 'rgba(196,149,106,.85)');
    grad.addColorStop(1, 'rgba(61,32,16,.25)');

    const chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: initialData.labels,
            datasets: [
                {
                    label: 'Revenue (EGP)',
                    data:  initialData.revenues,
                    backgroundColor: grad,
                    borderWidth: 0,
                    borderRadius: 5,
                    yAxisID: 'y'
                },
                {
                    label: '# Orders',
                    data:  initialData.orders,
                    type:  'line',
                    borderColor: BLUE,
                    backgroundColor: 'rgba(24,95,165,.08)',
                    pointBackgroundColor: BLUE,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: .4,
                    fill: true,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            animation: { duration:600, easing:'easeInOutQuart' },
            interaction: { mode:'index', intersect:false },
            plugins: {
                legend: { position:'top', labels:{ font:{size:11}, color:'#1b1c1c', boxWidth:10, padding:14 } },
                tooltip: { backgroundColor:BR, titleColor:'#f5e6d3', bodyColor:'#f5e6d3', padding:10, cornerRadius:8 }
            },
            scales: {
                x:  { grid:{display:false}, ticks:{font:{size:10}, color:'#888'} },
                y:  { type:'linear', position:'left',  grid:{color:'#f0ebe4'}, ticks:{font:{size:10}, color:'#888'} },
                y1: { type:'linear', position:'right', grid:{drawOnChartArea:false}, ticks:{font:{size:10}, color:'#888'} }
            }
        }
    });

    // ── 2. Donut chart ────────────────────────────────────────
    const todayRev = @Model.SalesSummary.TodaySales;
    const weekRev  = @Model.SalesSummary.WeekSales;
    const monthRev = @Model.SalesSummary.MonthSales;
    const total    = todayRev + weekRev + monthRev;

    // if all zero show placeholder slice
    const donutData = total > 0
        ? [todayRev, weekRev, monthRev]
        : [1, 1, 1];

    const dCtx = document.getElementById('donutChart').getContext('2d');
    new Chart(dCtx, {
        type: 'doughnut',
        data: {
            labels: ['Today', 'This Week', 'This Month'],
            datasets: [{
                data: donutData,
                backgroundColor: ['#3d2010', '#c4956a', '#f5e6d3'],
                borderColor:     ['#3d2010', '#c4956a', '#c4956a'],
                borderWidth: 2,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: false,
            cutout: '68%',
            animation: { duration:800, easing:'easeInOutQuart' },
            plugins: {
                legend: { display:false },
                tooltip: {
                    backgroundColor: BR,
                    titleColor: '#f5e6d3',
                    bodyColor:  '#f5e6d3',
                    padding: 8,
                    cornerRadius: 8,
                    callbacks: {
                        label: ctx => total > 0
                            ? ` EGP ${ctx.parsed.toLocaleString()}`
                            : ' No data yet'
                    }
                }
            }
        }
    });

    // ── Period switch AJAX ────────────────────────────────────
    document.querySelectorAll('.ptab').forEach(btn => {
        btn.addEventListener('click', async function () {
            document.querySelectorAll('.ptab').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const res  = await fetch(`/Admin/ChartData?period=${this.dataset.period}`);
            const data = await res.json();
            chart.data.labels           = data.labels;
            chart.data.datasets[0].data = data.revenues;
            chart.data.datasets[1].data = data.orders;
            chart.update();
        });
    });
</script>
}
