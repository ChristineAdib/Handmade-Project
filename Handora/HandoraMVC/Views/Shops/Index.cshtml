@model List<HandoraMVC.ViewModels.ShopListItemViewModel>

@{
    ViewData["Title"] = "Shops";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="shops-container">
    <div class="shops-header">
        <div class="header-left">
            <h2>Shops Management</h2>
            <p class="header-subtitle">Monitor shop performance, product listings, and sales across Handaura.</p>
        </div>
        <div class="header-right">
            <span class="shops-count-badge">
                <i class="ti ti-store"></i> @Model.Count Shops Registered
            </span>
        </div>
    </div>

    <div class="search-section">
        <form method="get" class="modern-search-bar">
            <div class="search-input-wrapper">
                <i class="ti ti-search search-icon"></i>
                <input type="text" name="search" value="@ViewData["Search"]"
                       placeholder="Search by shop name or owner..." class="search-input" />
                @if (!string.IsNullOrEmpty(ViewData["Search"] as string))
                {
                    <a href="@Url.Action("Index")" class="clear-search-btn" title="Clear Search">
                        <i class="ti ti-x"></i>
                    </a>
                }
            </div>
            <button type="submit" class="btn-search">Search</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-shops-state">
            <div class="empty-icon-wrapper">
                <i class="ti ti-store-off"></i>
            </div>
            <h3>No Shops Found</h3>
            <p>We couldn't find any shops matching "@ViewData["Search"]". Try refining your search query.</p>
            <a href="@Url.Action("Index")" class="btn-reset">View All Shops</a>
        </div>
    }
    else
    {
        <div class="shops-grid">
            @foreach (var shop in Model)
            {
                <a asp-action="Details" asp-route-id="@shop.Id" class="shop-card">
                    <div class="shop-card-inner">
                        <div class="shop-card-top">
                            <div class="logo-container">
                                @if (!string.IsNullOrEmpty(shop.Logo))
                                {
                                    <img src="@shop.Logo" alt="@shop.Name" class="shop-logo" />
                                }
                                else
                                {
                                    <div class="shop-logo-placeholder">
                                        <i class="ti ti-store" aria-hidden="true"></i>
                                    </div>
                                }
                            </div>
                            <div class="shop-title-meta">
                                <div class="shop-name-row">
                                    <span class="shop-name">@shop.Name</span>
                                    @if (shop.IsVerified)
                                    {
                                        <span class="verified-icon" title="Verified Shop">
                                            <i class="ti ti-discount-check-filled"></i>
                                        </span>
                                    }
                                </div>
                                <div class="shop-owner">by @shop.OwnerName</div>
                            </div>
                        </div>
                        
                        <div class="shop-card-stats">
                            <div class="stat-pill rating" title="Rating">
                                <span class="pill-icon"><i class="ti ti-star-filled"></i></span>
                                <span class="pill-val">@shop.Rating.ToString("F1") <span class="pill-sub">(@shop.ReviewCount)</span></span>
                            </div>
                            
                            <div class="stat-pill products" title="Product Count">
                                <span class="pill-icon"><i class="ti ti-package"></i></span>
                                <span class="pill-val">@shop.ProductCount <span class="pill-sub">items</span></span>
                            </div>
                            
                            <div class="stat-pill sales" title="Total Sales">
                                <span class="pill-icon"><i class="ti ti-coin"></i></span>
                                <span class="pill-val">@shop.TotalSales.ToString("C")</span>
                            </div>
                        </div>
                        
                        <div class="card-hover-footer">
                            <span>Manage Shop</span>
                            <i class="ti ti-arrow-narrow-right"></i>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<style>
    .shops-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
        animation: fadeIn 0.4s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Header */
    .shops-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(122, 84, 51, 0.12);
        padding-bottom: 20px;
    }

    .shops-header h2 {
        font-size: 24px;
        font-weight: 700;
        color: #3d2010;
        margin: 0;
    }

    .header-subtitle {
        font-size: 13px;
        color: #836753;
        margin-top: 4px;
    }

    .shops-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid rgba(196, 149, 106, 0.35);
        color: #7a5433;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(61, 32, 16, 0.04);
    }

    .shops-count-badge i {
        font-size: 16px;
        color: #c4956a;
    }

    /* Modern Search Section */
    .search-section {
        background: #fff;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid rgba(122, 84, 51, 0.08);
        box-shadow: 0 2px 8px rgba(61, 32, 16, 0.02);
    }

    .modern-search-bar {
        display: flex;
        gap: 12px;
        width: 100%;
    }

    .search-input-wrapper {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        color: #a28672;
        font-size: 18px;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        padding: 11px 16px 11px 42px;
        font-size: 14px;
        border: 1.5px solid rgba(196, 149, 106, 0.25);
        border-radius: 10px;
        outline: none;
        color: #1b1c1c;
        background-color: #faf8f6;
        transition: all 0.2s ease-in-out;
    }

    .search-input:focus {
        border-color: #c4956a;
        background-color: #fff;
        box-shadow: 0 0 0 3px rgba(196, 149, 106, 0.15);
    }

    .search-input::placeholder {
        color: #a28672;
        opacity: 0.8;
    }

    .clear-search-btn {
        position: absolute;
        right: 14px;
        color: #a28672;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
        border-radius: 50%;
        background: rgba(122, 84, 51, 0.06);
        transition: all 0.15s;
    }

    .clear-search-btn:hover {
        background: rgba(122, 84, 51, 0.12);
        color: #3d2010;
    }

    .btn-search {
        background: #7a5433;
        color: #fff;
        border: none;
        padding: 0 24px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 3px 6px rgba(122, 84, 51, 0.15);
    }

    .btn-search:hover {
        background: #5c3d22;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(92, 61, 34, 0.25);
    }

    /* Grid Layout */
    .shops-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    /* Modern Shop Card */
    .shop-card {
        background: #fff;
        border: 1px solid rgba(196, 149, 106, 0.18);
        border-radius: 16px;
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 4px 12px rgba(61, 32, 16, 0.02);
    }

    .shop-card:hover {
        transform: translateY(-4px);
        border-color: #c4956a;
        box-shadow: 0 10px 24px rgba(61, 32, 16, 0.08);
    }

    .shop-card-inner {
        padding: 20px;
        display: flex;
        flex-direction: column;
        height: 100%;
        gap: 16px;
    }

    .shop-card-top {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .logo-container {
        position: relative;
    }

    .shop-logo {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        object-fit: cover;
        border: 1.5px solid rgba(196, 149, 106, 0.15);
        background: #faf8f6;
    }

    .shop-logo-placeholder {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background: #fbf6f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #c4956a;
        border: 1.5px solid rgba(196, 149, 106, 0.15);
    }

    .shop-title-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex: 1;
        min-width: 0;
    }

    .shop-name-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .shop-name {
        font-weight: 700;
        font-size: 16px;
        color: #3d2010;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .verified-icon {
        color: #c4956a;
        font-size: 16px;
        display: inline-flex;
        align-items: center;
    }

    .shop-owner {
        font-size: 12px;
        color: #9c8475;
        font-weight: 500;
    }

    /* Stats Section with pills */
    .shop-card-stats {
        display: flex;
        flex-direction: column;
        gap: 8px;
        border-top: 1px dashed rgba(122, 84, 51, 0.12);
        padding-top: 16px;
    }

    .stat-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .stat-pill .pill-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 6px;
    }

    .stat-pill .pill-val {
        color: #3d2010;
    }

    .stat-pill .pill-sub {
        font-size: 11px;
        font-weight: 400;
        color: #9c8475;
        margin-left: 2px;
    }

    /* Rating specific */
    .stat-pill.rating {
        background: rgba(255, 193, 7, 0.08);
    }
    .stat-pill.rating .pill-icon {
        background: rgba(255, 193, 7, 0.15);
        color: #b28500;
    }

    /* Products specific */
    .stat-pill.products {
        background: rgba(196, 149, 106, 0.08);
    }
    .stat-pill.products .pill-icon {
        background: rgba(196, 149, 106, 0.18);
        color: #9a7055;
    }

    /* Sales specific */
    .stat-pill.sales {
        background: rgba(40, 167, 69, 0.08);
    }
    .stat-pill.sales .pill-icon {
        background: rgba(40, 167, 69, 0.15);
        color: #1e7e34;
    }

    /* Card Footer inside link */
    .card-hover-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 700;
        color: #c4956a;
        margin-top: auto;
        padding-top: 8px;
        border-top: 1px solid rgba(122, 84, 51, 0.05);
        transition: color 0.2s, transform 0.2s;
    }

    .shop-card:hover .card-hover-footer {
        color: #7a5433;
    }

        .shop-card-stats i {
            margin-right: 4px;
        }

    @@media (max-width: 480px) {
        .filter-bar {
            display: flex;
            width: 100%;
        }
        .form-input {
            max-width: 100% !important;
            flex: 1;
        }
        .shop-card-stats {
            flex-wrap: wrap;
            gap: 8px;
        }
    .shop-card:hover .card-hover-footer i {
        transform: translateX(4px);
    }

    .card-hover-footer i {
        font-size: 16px;
        transition: transform 0.2s;
    }

    /* Empty State */
    .empty-shops-state {
        text-align: center;
        padding: 48px 24px;
        background: #fff;
        border-radius: 16px;
        border: 1px dashed rgba(196, 149, 106, 0.4);
    }

    .empty-icon-wrapper {
        font-size: 48px;
        color: #c4956a;
        margin-bottom: 16px;
    }

    .empty-shops-state h3 {
        font-size: 18px;
        font-weight: 700;
        color: #3d2010;
        margin-bottom: 8px;
    }

    .empty-shops-state p {
        color: #836753;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .btn-reset {
        display: inline-block;
        background: #7a5433;
        color: #fff;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s;
    }

    .btn-reset:hover {
        background: #5c3d22;
    }
</style>