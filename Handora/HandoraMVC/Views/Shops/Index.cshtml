@model List<HandoraMVC.ViewModels.ShopListItemViewModel>

@{
    ViewData["Title"] = "Shops";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h2>Shops</h2>
    <span class="total-badge">@Model.Count total</span>
</div>
<form method="get" class="filter-bar">
    <input type="text" name="search" value="@ViewData["Search"]"
           placeholder="Search by shop name..." class="form-input" style="max-width:280px" />
    <button type="submit" class="btn-secondary" style="margin-left:8px">
        <i class="ti ti-search" aria-hidden="true"></i>
    </button>
</form>
<div class="shops-grid">
    @foreach (var shop in Model)
    {
        <a asp-action="Details" asp-route-id="@shop.Id" class="shop-card">
            <div class="shop-card-top">
                @if (!string.IsNullOrEmpty(shop.Logo))
                {
                    <img src="@shop.Logo" alt="@shop.Name" class="shop-logo" />
                }
                else
                {
                    <div class="shop-logo-placeholder">
                        <i class="ti ti-store" aria-hidden="true"></i>
                    </div>
                }
                <div>
                    <div class="shop-name">@shop.Name</div>
                    <div class="shop-owner">by @shop.OwnerName</div>
                </div>
            </div>
            <div class="shop-card-stats">
                <span><i class="ti ti-star-filled" aria-hidden="true"></i> @shop.Rating.ToString("F1") (@shop.ReviewCount)</span>
                <span><i class="ti ti-package" aria-hidden="true"></i> @shop.ProductCount</span>
                <span><i class="ti ti-coin" aria-hidden="true"></i> @shop.TotalSales.ToString("C")</span>
            </div>
        </a>
    }
</div>

<style>
    .shops-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 14px;
    }

    .shop-card {
        background: #fff;
        border: 0.5px solid #e8e0d8;
        border-radius: 12px;
        padding: 16px;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: box-shadow 0.15s, border-color 0.15s;
    }

        .shop-card:hover {
            border-color: #c4956a;
            box-shadow: 0 2px 10px rgba(61,32,16,0.06);
        }

    .shop-card-top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .shop-logo {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        object-fit: cover;
    }

    .shop-logo-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: #f5ede4;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #c4956a;
    }

    .shop-name {
        font-weight: 600;
        font-size: 15px;
        color: #1b1c1c;
    }

    .shop-owner {
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }

    .shop-card-stats {
        display: flex;
        gap: 14px;
        font-size: 12px;
        color: #7a5433;
        border-top: 0.5px solid #f0ebe4;
        padding-top: 10px;
    }

        .shop-card-stats i {
            margin-right: 4px;
        }

    @@media (max-width: 480px) {
        .filter-bar {
            display: flex;
            width: 100%;
        }
        .form-input {
            max-width: 100% !important;
            flex: 1;
        }
        .shop-card-stats {
            flex-wrap: wrap;
            gap: 8px;
        }
    }
</style>