{
  "info": {
    "name": "Handora API",
    "description": "Complete API collection for Handora marketplace. All 58 endpoints across 14 controllers.\n\n## Authentication\n- Register → Verify OTP → Login (gets JWT token automatically saved)\n- Protected endpoints use `Authorization: Bearer {{token}}`\n\n## Variables\n- `baseUrl`: API base URL (default: http://localhost:5216)\n- `token`: Auto-set after login\n- `userId`, `orderId`, `productId`, `shopId`, `conversationId`: IDs for chaining requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5216",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shopId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication endpoints - Register, Verify OTP, Login, and User Management",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('userId', jsonData.userId || jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "Name", "value": "John Doe", "type": "text" },
                { "key": "Email", "value": "john@example.com", "type": "text" },
                { "key": "Password", "value": "Password123!", "type": "text" },
                { "key": "ConfirmPassword", "value": "Password123!", "type": "text" },
                { "key": "PhoneNumber", "value": "+201234567890", "type": "text" },
                { "key": "Role", "value": "Buyer", "type": "text", "description": "Buyer or Seller" },
                { "key": "Bio", "value": "Handmade enthusiast", "type": "text" },
                { "key": "ProfileImage", "value": "", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user. Sends OTP to email. Supports Buyer and Seller roles."
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            },
            "description": "Verify the OTP code sent to email after registration."
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "resend-otp"]
            },
            "description": "Resend a new OTP code to the user's email."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token || jsonData.accessToken);",
                  "    pm.collectionVariables.set('userId', jsonData.userId || jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login with email and password. JWT token is automatically saved to `{{token}}` variable."
          },
          "response": []
        },
        {
          "name": "Get All Users [Admin]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users"]
            },
            "description": "Get all users. Requires Admin role."
          },
          "response": []
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "{{userId}}"]
            },
            "description": "Get user by ID. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "Name", "value": "John Updated", "type": "text" },
                { "key": "PhoneNumber", "value": "+201234567891", "type": "text" },
                { "key": "Bio", "value": "Updated bio", "type": "text" },
                { "key": "ProfileImage", "value": "", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "{{userId}}"]
            },
            "description": "Update user profile. Multipart form-data."
          },
          "response": []
        },
        {
          "name": "Delete User [Admin]",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "{{userId}}"]
            },
            "description": "Delete user by ID. Requires Admin role."
          },
          "response": []
        }
      ]
    },
