  //  "CollectionName": "handora_products"
  //},
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_KEY",
    "ChatModel": "gpt-4.1-mini",
    "EmbeddingModel": "text-embedding-3-small"
  },

  "Qdrant": {
    "Url": "https://YOUR-CLUSTER-URL",
    "ApiKey": "YOUR-API-KEY",
    "Collection": "handora-documents"
  },
  
  "AllowedHosts": "*"
}