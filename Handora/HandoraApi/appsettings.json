{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HandoraDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "JwtOptions": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "HandoraApi",
    "Audience": "HandoraUsers",
    "ExpirationMinutes": 60
  },
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com",
    "ApiKey": "YOUR_PAYMOB_API_KEY",
    "PublicKey": "YOUR_PAYMOB_PUBLIC_KEY",
    "SecretKey": "YOUR_PAYMOB_SECRET_KEY",
    "Hmac": "YOUR_PAYMOB_HMAC",
    "IntegrationId": 0,
    "IframeId": 0,
    "FrontendCallbackUrl": "http://localhost:4200/payment/callback"
  },
  "JWT": {
    "ValidIssuer": "*",
    "ValidAudience": "*",
    "Secret": "YOUR_JWT_SECRET"
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "YOUR_EMAIL@gmail.com",
    "SenderPassword": "YOUR_SMTP_APP_PASSWORD",
    "EnableSsl": true
  },
  "AIProvider": "GoogleImagen",
  "AiImageGenerator": {
    "ActiveProvider": "GoogleImagen",
    "GenerateCount": 3,
    "EnableQualityValidation": true,
    "MinImageSizeBytes": 10000,
    "GoogleAIStudio": {
      "ApiKey": "YOUR_GOOGLE_AI_STUDIO_API_KEY",
      "ModelName": "imagen-4.0-generate-001",
      "BaseUrl": "https://generativelanguage.googleapis.com"
    },
    "Pollinations": {
      "BaseUrl": "https://image.pollinations.ai",
      "Model": "flux"
    },
    "MockProvider": {
      "MockImageUrl": "https://res.cloudinary.com/demo/image/upload/v1312461204/sample.jpg"
    }
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "OtpSettings": {
    "ExpiryMinutes": 10
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "ChatModel": "gpt-4.1-mini",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Qdrant": {
    "Url": "YOUR_QDRANT_CLUSTER_URL",
    "ApiKey": "YOUR_QDRANT_API_KEY",
    "Collection": "handora-documents"
  },
  "AllowedHosts": "*"
}